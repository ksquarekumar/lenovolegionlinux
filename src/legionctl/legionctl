def doctor(profile):
    warnings = []
    if dmi_mismatches(profile):
        warnings.append("DMI does not match this repo profile")

    override = firmware_override()
    current_profile = read_text(profile["paths"]["platform_profile"])
    wanted_profile = override or (
        platform_choice(profile, "ac") if is_ac_online(profile) else platform_choice(profile, "battery")
    )
    if wanted_profile and current_profile != wanted_profile:
        warnings.append(f"platform_profile is {current_profile!r}, expected {wanted_profile!r}")

    fan_paths = fan_mode_paths(profile)
    wanted_fan = profile["ac"]["firmware"].get("fan_mode") if is_ac_online(profile) else None
    if fan_paths and wanted_fan is not None:
        for path in fan_paths:
            if read_text(path) != wanted_fan:
                warnings.append(f"{path} is {read_text(path)!r}, expected {wanted_fan!r}")

    mode = "ac" if is_ac_online(profile) else "battery"
    expected_cpu = profile[mode]["cpu"]
    expected_governor = expected_cpu.get("governor")
    if override:
        # following Fn+Q: governor comes from firmware_follow, EPP from power-profiles-daemon
        follow = profile.get("firmware_follow", {}).get(override, {})
        expected_cpu = {"governor": follow.get("governor")}
        expected_governor = expected_cpu["governor"]
    if expected_governor:
        wrong = [name for name, value in cpufreq_values("scaling_governor").items() if value != expected_governor]
        if wrong:
            warnings.append(f"{len(wrong)} cpufreq policies are not using governor {expected_governor!r}")
    expected_epp = expected_cpu.get("energy_performance_preference")
    if expected_epp:
        wrong = [name for name, value in cpufreq_values("energy_performance_preference").items() if value != expected_epp]
        if wrong:
            warnings.append(f"{len(wrong)} cpufreq policies are not using EPP {expected_epp!r}")

    for key, value in sysctl_settings(profile, mode).items():
        current = read_text(sysctl_path(key))
        if current is not None and current != str(value):
            warnings.append(f"sysctl {key} is {current!r}, expected {str(value)!r}")

    for unit in profile["conflicts"]["systemd_units"]:
        active = systemctl_is_active(unit)
        enabled = systemctl_is_enabled(unit)
        if active == "active" or enabled not in ("disabled", "not-found", "masked", "unknown"):
            warnings.append(f"conflicting unit {unit}: active={active}, enabled={enabled}")

    for package in installed_conflict_packages(profile):
        warnings.append(f"conflicting package is installed: {package}")

    modules = loaded_modules()
    for module in profile["conflicts"].get("modules", []):
        if module in modules:
            warnings.append(f"conflicting module is loaded: {module}")
    if "thinkpad_acpi" in modules:
        fan_state = read_text("/proc/acpi/ibm/fan")
        if fan_state and "status:\t\tenabled" in fan_state:
            warnings.append("thinkpad_acpi fan control appears enabled; this is not trusted on this machine")

    warnings.extend(module_warnings(profile))
    therm = read_package_therm_status()
    if therm is not None and {"PROCHOT", "critical temperature"} & set(throttle_reasons(therm)):
        warnings.append(f"CPU throttling logged: {', '.join(throttle_reasons(therm))}")
    for volume in dirty_ntfs_messages():
        warnings.append(
            f"NTFS volume {volume} is marked dirty; run chkdsk in Windows (or ntfsfix -d, see docs/design/11-disks.md)"
        )
    outputs = gpu_outputs()
    external_on_nvidia = any(o[3] and o[2] == "nvidia" and not o[0].startswith("eDP") for o in outputs)
    if gpu_mode(outputs) == "hybrid" and external_on_nvidia and preferred_primary_gpu() != "nvidia":
        warnings.append(
            "an external display runs on NVIDIA but the desktop may be drawn on Intel; try `legionctl gpu primary nvidia`"
        )

    power_limit = nvidia_power_limit()
    expected = str(profile["ac"]["nvidia"]["expected_dynamic_power_w"])
    nvidia_powerd_state = systemctl_is_active("nvidia-powerd.service")
    nvidia_persistenced_state = systemctl_is_active("nvidia-persistenced.service")
    if is_ac_online(profile) and nvidia_powerd_state not in ("active", "unknown"):
        warnings.append("nvidia-powerd.service is not active on AC")
    if is_ac_online(profile) and nvidia_persistenced_state not in ("active", "unknown"):
        warnings.append("nvidia-persistenced.service is not active on AC")
    # nvidia-powerd Dynamic Boost moves the limit between the base and base+25 W
    if is_ac_online(profile) and power_limit and not 0 <= float(power_limit) - float(expected) <= 25:
        warnings.append(f"NVIDIA power limit is {power_limit} W, expected around {expected} W on AC")

    if warnings:
        print("doctor: warnings")
        for warning in warnings:
            print(f"- {warning}")
        return 1
    print("doctor: no obvious conflicts")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description="Local Lenovo Legion 82WQ power controller")
    parser.add_argument("--profile", help="profile JSON path")
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="print current state")
    status.set_defaults(func=cmd_status)

    doctor_cmd = sub.add_parser("doctor", help="print conflict and drift warnings")
    doctor_cmd.set_defaults(func=cmd_doctor)

    capabilities_cmd = sub.add_parser("capabilities", help="print known and planned Legion capability coverage")
    capabilities_cmd.set_defaults(func=cmd_capabilities)

    apply_cmd = sub.add_parser("apply", help="apply ac, battery, or auto policy")
    apply_cmd.add_argument("mode", choices=["ac", "battery", "auto"])
    apply_cmd.add_argument("--dry-run", action="store_true")
    apply_cmd.add_argument("--force", action="store_true")
    apply_cmd.add_argument("--quiet", action="store_true")
    apply_cmd.add_argument("--keep-override", action="store_true", help="keep an Fn+Q choice (used after resume)")
    apply_cmd.set_defaults(func=cmd_apply)

    gpu_cmd = sub.add_parser("gpu", help="show GPU wiring, or choose which GPU draws the desktop")
    gpu_cmd.add_argument("action", nargs="?", choices=["status", "primary"], default="status")
    gpu_cmd.add_argument("choice", nargs="?", choices=["nvidia", "intel", "auto"])
    gpu_cmd.add_argument("--dry-run", action="store_true")
    gpu_cmd.set_defaults(func=cmd_gpu)

    run_cmd = sub.add_parser("run", help="run a program on a chosen GPU, core class and priority")
    run_cmd.add_argument("--gpu", choices=["nvidia", "intel", "default"], default="default")
    run_cmd.add_argument("--cores", choices=["p", "e", "all"], default="all")
    run_cmd.add_argument("--nice", type=int)
    run_cmd.add_argument("cmd", nargs=argparse.REMAINDER)
    run_cmd.set_defaults(func=cmd_run)

    reassert_cmd = sub.add_parser("reassert", help="reassert firmware-only policy")
    reassert_cmd.add_argument("mode", choices=["ac", "battery", "auto"])
    reassert_cmd.add_argument("--dry-run", action="store_true")
    reassert_cmd.add_argument("--force", action="store_true")
    reassert_cmd.add_argument("--quiet", action="store_true")
    reassert_cmd.set_defaults(func=cmd_reassert)

    cleanup_cmd = sub.add_parser("cleanup", help="disable old local Legion power-management conflicts")
    cleanup_cmd.add_argument("--dry-run", action="store_true")
    cleanup_cmd.add_argument("--force", action="store_true")
    cleanup_cmd.add_argument("--quiet", action="store_true")
    cleanup_cmd.add_argument("--unload-modules", action="store_true")
    cleanup_cmd.add_argument("--remove-packages", action="store_true")
    cleanup_cmd.set_defaults(func=cmd_cleanup)

    follow_cmd = sub.add_parser("follow", help="react to a firmware platform_profile change (Fn+Q); run by udev")
    follow_cmd.add_argument("--dry-run", action="store_true")
    follow_cmd.add_argument("--quiet", action="store_true")
    follow_cmd.set_defaults(func=cmd_follow)

    validate_cmd = sub.add_parser("validate", help="check profile structure and ac/battery consistency (no hardware access)")
    validate_cmd.set_defaults(func=cmd_validate)

    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


def cmd_status(args):
