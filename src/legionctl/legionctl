#!/usr/bin/env python3
import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULT_PROFILE = Path("/usr/share/legionctl/profiles/lenovo-82wq-legion-pro-7-16irx8h.json")
REPO_PROFILE = Path(__file__).resolve().parents[2] / "profiles" / "lenovo-82wq-legion-pro-7-16irx8h.json"
DMI_ROOT = Path("/sys/class/dmi/id")
POWERCAP_ROOT = Path("/sys/class/powercap")


class Runner:
    def __init__(self, dry_run=False, quiet=False):
        self.dry_run = dry_run
        self.quiet = quiet
        self.changed = []
        self.warnings = []

    def info(self, message):
        if not self.quiet:
            print(message)

    def warn(self, message):
        self.warnings.append(message)
        print(f"warning: {message}", file=sys.stderr)

    def write(self, path, value, required=False):
        path = Path(path)
        text = str(value)
        if not text.endswith("\n"):
            text += "\n"
        if not path.exists():
            if required:
                raise RuntimeError(f"missing required path: {path}")
            self.warn(f"missing path: {path}")
            return False
        if self.dry_run:
            current = read_text(path)
            if current is not None and current.strip() == str(value):
                return True
            self.info(f"would write {path}: {value}")
            return True
        if not os.access(path, os.W_OK):
            if required:
                raise RuntimeError(f"path is not writable: {path}")
            self.warn(f"path is not writable: {path}")
            return False
        current = read_text(path)
        if current is not None and current.strip() == str(value):
            return True
        if self.dry_run:
            self.info(f"would write {path}: {value}")
            return True
        path.write_text(text)
        self.changed.append(str(path))
        self.info(f"wrote {path}: {value}")
        after = read_text(path)
        if after is not None and after.strip() != str(value):
            self.warn(f"{path} read back as {after!r} after writing {value!r}")
        return True

    def run(self, argv, required=False, warn_on_failure=True):
        if shutil.which(argv[0]) is None:
            if required:
                raise RuntimeError(f"missing command: {argv[0]}")
            if warn_on_failure:
                self.warn(f"missing command: {argv[0]}")
            return False
        if self.dry_run:
            self.info("would run: " + " ".join(argv))
            return True
        result = subprocess.run(argv, text=True, capture_output=True)
        if result.returncode != 0:
            message = " ".join(argv)
            detail = (result.stderr or result.stdout).strip()
            if required:
                raise RuntimeError(f"command failed: {message}: {detail}")
            if warn_on_failure:
                self.warn(f"command failed: {message}: {detail}")
            return False
        return True


def read_text(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return None


def load_profile(path):
    if path:
        profile_path = Path(path)
    elif DEFAULT_PROFILE.exists():
        profile_path = DEFAULT_PROFILE
    else:
        profile_path = REPO_PROFILE
    return json.loads(profile_path.read_text()), profile_path


def read_dmi():
    keys = [
        "bios_vendor",
        "bios_version",
        "bios_date",
        "bios_release",
        "ec_firmware_release",
        "sys_vendor",
        "product_name",
        "product_family",
        "product_version",
        "product_sku",
        "board_name",
        "bios_version",
    ]
    return {key: read_text(DMI_ROOT / key) for key in keys}


def dmi_mismatches(profile):
    live = read_dmi()
    expected = profile.get("dmi_match") or profile.get("dmi")
    if not expected:
        raise RuntimeError("profile has no dmi_match or dmi section")
    mismatches = []
    for key, expected_value in expected.items():
        live_value = live.get(key)
        if live_value != expected_value:
            mismatches.append((key, expected_value, live_value))
    return mismatches


def require_supported_machine(profile, force=False):
    mismatches = dmi_mismatches(profile)
    if mismatches and not force:
        lines = ["DMI profile mismatch; refusing to apply policy for this machine:"]
        for key, expected, actual in mismatches:
            lines.append(f"  {key}: expected {expected!r}, got {actual!r}")
        lines.append("Use --force only if you intentionally want to override this guard.")
        raise RuntimeError("\n".join(lines))


def is_ac_online(profile):
    path = profile["paths"]["ac_adapter"]
    return read_text(path) == "1"


def choose_auto_mode(profile):
    return "ac" if is_ac_online(profile) else "battery"


def powercap_package_zones():
    zones = []
    for path in sorted(POWERCAP_ROOT.glob("intel-rapl*:*")):
        name = read_text(path / "name")
        if name == "package-0" and ":" in path.name and path.name.count(":") == 1:
            zones.append(path)
    return zones


def constraint_index(zone, constraint_name):
    for name_file in sorted(zone.glob("constraint_*_name")):
        if read_text(name_file) == constraint_name:
            return name_file.name.split("_")[1]
    return None


def apply_rapl(runner, profile, mode):
    rapl = profile[mode].get("rapl", {})
    constraints = rapl.get("constraints", {})
    zones = powercap_package_zones()
    if not zones:
        runner.warn("no package RAPL zones found under /sys/class/powercap")
        return
    for zone in zones:
        for name, values in constraints.items():
            index = constraint_index(zone, name)
            if index is None:
                runner.warn(f"{zone} has no RAPL constraint named {name}")
                continue
            power_limit = values.get("power_limit_uw")
            if power_limit is not None:
                runner.write(zone / f"constraint_{index}_power_limit_uw", power_limit)
            time_window = values.get("time_window_us")
            if time_window is not None:
                runner.write(zone / f"constraint_{index}_time_window_us", time_window)


def sysctl_settings(profile, mode):
    # top-level "sysctl" applies in every mode; "<mode>.sysctl" overrides per power source
    return {**profile.get("sysctl", {}), **profile[mode].get("sysctl", {})}


def sysctl_path(key):
    return Path("/proc/sys") / key.replace(".", "/")


def apply_sysctl(runner, profile, mode):
    for key, value in sysctl_settings(profile, mode).items():
        runner.write(sysctl_path(key), value)


def set_power_profile(runner, wanted):
    # keep power-profiles-daemon (GNOME Power Mode) in step with the legion mode instead of fighting it
    if not wanted or shutil.which("powerprofilesctl") is None:
        return
    result = subprocess.run(["powerprofilesctl", "get"], text=True, capture_output=True)
    if result.stdout.strip() != wanted:
        runner.run(["powerprofilesctl", "set", wanted])


def apply_power_profile(runner, profile, mode):
    set_power_profile(runner, profile[mode].get("power_profile"))


def write_cpufreq(runner, name, value):
    if value:
        for policy in sorted(Path("/sys/devices/system/cpu/cpufreq").glob("policy*")):
            runner.write(policy / name, value)


def apply_cpu_governor_epp(runner, profile, mode):
    cpu = profile[mode].get("cpu", {})
    write_cpufreq(runner, "scaling_governor", cpu.get("governor"))
    write_cpufreq(runner, "energy_performance_preference", cpu.get("energy_performance_preference"))


def apply_cpu_policy(runner, profile, mode):
    cpu = profile[mode].get("cpu", {})
    if "ignore_ppc" in cpu:
        runner.write("/sys/module/processor/parameters/ignore_ppc", cpu["ignore_ppc"])
    if "no_turbo" in cpu:
        runner.write("/sys/devices/system/cpu/intel_pstate/no_turbo", cpu["no_turbo"])
    if "max_perf_pct" in cpu:
        runner.write("/sys/devices/system/cpu/intel_pstate/max_perf_pct", cpu["max_perf_pct"])

    apply_cpu_governor_epp(runner, profile, mode)

    perf_bias = cpu.get("energy_perf_bias")
    if perf_bias is not None:
        for bias_file in sorted(Path("/sys/devices/system/cpu").glob("cpu*/power/energy_perf_bias")):
            runner.write(bias_file, perf_bias)
        if shutil.which("cpupower"):
            runner.run(["cpupower", "set", "--perf-bias", str(perf_bias)])

    # re-enable every C-state in case something disabled them; deep idle frees turbo headroom
    if cpu.get("enable_all_idle_states"):
        runner.run(["cpupower", "idle-set", "-E"])


def platform_choice(profile, mode):
    firmware = profile[mode].get("firmware", {})
    profile_path = Path(profile["paths"]["platform_profile_choices"])
    choices_text = read_text(profile_path) or ""
    choices = choices_text.split()
    for choice in firmware.get("platform_profile_preference", []):
        if choice in choices:
            return choice
    return None


def fan_mode_paths(profile):
    configured = Path(profile["paths"]["fan_mode"])
    if configured.exists():
        return [configured]
    return [Path(p) for p in glob.glob("/sys/devices/**/VPC2004:00/fan_mode", recursive=True)]


# Fn+Q changes platform_profile in firmware and emits the same uevent as our own writes. We record every
# value we write; a change to anything else is the user's choice, kept as an override until the power
# source changes, the machine reboots (/run is tmpfs), or `apply` runs.
STATE_DIR = Path("/run/legionctl")
WRITTEN_FILE = STATE_DIR / "firmware-written"
OVERRIDE_FILE = STATE_DIR / "firmware-override"


def save_state(runner, path, value):
    if runner.dry_run:
        return
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(f"{value}\n")


def firmware_override():
    return read_text(OVERRIDE_FILE)


def clear_firmware_override(runner):
    if firmware_override() is not None:
        runner.info(f"clearing firmware override {firmware_override()!r}")
        if not runner.dry_run:
            OVERRIDE_FILE.unlink(missing_ok=True)


def apply_follow_policy(runner, profile, firmware_mode):
    follow = profile.get("firmware_follow", {}).get(firmware_mode)
    if not follow:
        runner.warn(f"no firmware_follow entry for {firmware_mode!r}; leaving CPU policy alone")
        return
    set_power_profile(runner, follow.get("power_profile"))
    write_cpufreq(runner, "scaling_governor", follow.get("governor"))


def apply_firmware_policy(runner, profile, mode):
    chosen = platform_choice(profile, mode)
    if chosen:
        runner.write(profile["paths"]["platform_profile"], chosen)
        save_state(runner, WRITTEN_FILE, chosen)
    else:
        runner.warn("no matching platform_profile choice found")

    fan_mode = profile[mode].get("firmware", {}).get("fan_mode")
    if fan_mode is not None:
        paths = fan_mode_paths(profile)
        if not paths:
            runner.warn("no VPC2004 fan_mode path found")
        for path in paths:
            runner.write(path, fan_mode)


FIRMWARE_ATTRIBUTES = Path("/sys/class/firmware-attributes/lenovo-wmi-other-0/attributes")


def firmware_attribute(name):
    base = FIRMWARE_ATTRIBUTES / name
    return {key: read_text(base / key) for key in ("current_value", "min_value", "max_value")}


def firmware_attributes_status():
    if not FIRMWARE_ATTRIBUTES.is_dir():
        return {}
    return {path.name: firmware_attribute(path.name) for path in sorted(FIRMWARE_ATTRIBUTES.iterdir())}


def apply_firmware_attributes(runner, profile, mode):
    for name, value in profile[mode].get("firmware_attributes", {}).items():
        attr = firmware_attribute(name)
        if attr["current_value"] is None:
            runner.warn(f"firmware attribute {name} not found")
            continue
        low, high = int(attr["min_value"] or 0), int(attr["max_value"] or 0)
        # some attributes publish min=max=0, meaning the firmware does not report a range
        if high and not low <= int(value) <= high:
            runner.warn(f"firmware attribute {name}={value} is outside {low}-{high}; skipped")
            continue
        runner.write(FIRMWARE_ATTRIBUTES / name / "current_value", value)


def apply_nvidia_policy(runner, profile, mode):
    if mode != "ac":
        return
    nvidia = profile[mode].get("nvidia", {})
    if nvidia.get("start_persistenced"):
        runner.run(["systemctl", "start", "nvidia-persistenced.service"])
    if nvidia.get("start_powerd"):
        runner.run(["systemctl", "start", "nvidia-powerd.service"])
    if nvidia.get("set_persistence_mode"):
        runner.run(["nvidia-smi", "-i", "0", "-pm", "1"])


def apply_mode(runner, profile, mode, force=False, reassert=False, keep_override=False):
    if mode == "auto":
        mode = choose_auto_mode(profile)
    require_supported_machine(profile, force=force)
    if mode not in ("ac", "battery"):
        raise RuntimeError(f"invalid mode: {mode}")
    if mode == "battery" and is_ac_online(profile):
        runner.warn("ADP0 is online but battery policy was requested")
    if mode == "ac" and not is_ac_online(profile):
        runner.warn("ADP0 is offline but AC policy was requested")

    if not reassert and not keep_override:
        # a power-source change, boot or manual apply starts from the profile defaults again
        clear_firmware_override(runner)
    override = firmware_override()
    if override:
        apply_follow_policy(runner, profile, override)
    else:
        apply_firmware_policy(runner, profile, mode)
        # intel_pstate refuses EPP writes while the governor is performance, which makes PPD fail; governor first
        write_cpufreq(runner, "scaling_governor", profile[mode].get("cpu", {}).get("governor"))
        apply_power_profile(runner, profile, mode)
        if reassert:
            # power-profiles-daemon rewrites governor/EPP on profile changes; reassert wins them back
            apply_cpu_governor_epp(runner, profile, mode)
    # firmware mode changes and resume rewrite the MMIO RAPL limits; restoring them only writes what drifted
    apply_rapl(runner, profile, mode)
    apply_firmware_attributes(runner, profile, mode)
    if not reassert:
        apply_sysctl(runner, profile, mode)
        apply_cpu_policy(runner, profile, mode)
        apply_nvidia_policy(runner, profile, mode)
    return mode


DRM = Path("/sys/class/drm")
PRIMARY_GPU_RULE = Path("/etc/udev/rules.d/61-legion-mutter-primary.rules")
PRIMARY_GPU_DRIVERS = {"nvidia": "nvidia", "intel": "i915"}


def gpu_outputs(drm=DRM):
    """(connector, card, driver, connected) for every DRM connector."""
    rows = []
    for connector in sorted(drm.glob("card*-*")):
        card, name = connector.name.split("-", 1)
        driver = Path(os.path.realpath(drm / card / "device" / "driver")).name
        rows.append((name, card, driver, read_text(connector / "status") == "connected"))
    return rows


def gpu_mode(outputs):
    """hybrid: built-in panel on the iGPU; discrete: panel wired to NVIDIA (MUX)."""
    panels = [o for o in outputs if o[0].startswith("eDP") and o[3]]
    if not panels:
        return "unknown"
    return "discrete" if panels[0][2] == "nvidia" else "hybrid"


def preferred_primary_gpu():
    text = read_text(PRIMARY_GPU_RULE)
    for name, driver in PRIMARY_GPU_DRIVERS.items():
        if text and f'DRIVERS=="{driver}"' in text:
            return name
    return "auto"


def primary_gpu_rule(choice):
    driver = PRIMARY_GPU_DRIVERS[choice]
    return (
        "# lenovolegionlinux: GPU that Mutter uses to draw the desktop (read at login)\n"
        f'SUBSYSTEM=="drm", KERNEL=="card*", DRIVERS=="{driver}", TAG+="mutter-device-preferred-primary"\n'
    )


def cpu_class_cpus(kind, devices=Path("/sys/devices")):
    """CPU list for performance (p) or efficiency (e) cores on hybrid Intel CPUs."""
    return read_text(devices / {"p": "cpu_core", "e": "cpu_atom"}[kind] / "cpus")


def gpu_env(gpu, drm=DRM):
    if gpu == "nvidia":
        return {"__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia", "__VK_LAYER_NV_optimus": "NVIDIA_only"}
    if gpu == "intel":
        env = {
            "__GLX_VENDOR_LIBRARY_NAME": "mesa",
            "__EGL_VENDOR_LIBRARY_FILENAMES": "/usr/share/glvnd/egl_vendor.d/50_mesa.json",
        }
        for card in sorted(drm.glob("card[0-9]")):
            if Path(os.path.realpath(card / "device" / "driver")).name in ("i915", "xe"):
                device = (read_text(card / "device" / "device") or "").removeprefix("0x")
                env["MESA_VK_DEVICE_SELECT"] = f"8086:{device}!"
        return env
    return {}


# Kernel modules: what this machine relies on, checked for every installed kernel.
MODULES_LOAD_DIRS = (Path("/etc/modules-load.d"), Path("/usr/lib/modules-load.d"))


def parse_modules_load(text):
    return [line.strip() for line in text.splitlines() if line.strip() and not line.strip().startswith(("#", ";"))]


def autoload_entries(dirs=MODULES_LOAD_DIRS):
    entries = {}
    for directory in dirs:
        for conf in sorted(directory.glob("*.conf")) if directory.is_dir() else []:
            for module in parse_modules_load(read_text(conf) or ""):
                entries.setdefault(module.replace("-", "_"), str(conf))
    return entries


def installed_kernels(root=Path("/usr/lib/modules")):
    return sorted(p.name for p in root.iterdir() if (p / "vmlinuz").exists()) if root.is_dir() else []


def module_available(name, kernel):
    if shutil.which("modinfo") is None:
        return True
    result = subprocess.run(["modinfo", "-k", kernel, "-F", "filename", name], text=True, capture_output=True)
    return result.returncode == 0 and bool(result.stdout.strip())


def parse_dkms_status(text):
    """[(module/version, kernel, state)] from `dkms status` lines like 'nvidia/580, 7.2.9-cachyos, x86_64: installed'."""
    rows = []
    for line in text.splitlines():
        head, _, state = line.partition(": ")
        parts = [part.strip() for part in head.split(",")]
        if len(parts) >= 3 and state:
            rows.append((parts[0], parts[1], state.strip()))
    return rows


def module_warnings(profile):
    spec = profile.get("kernel_modules", {})
    warnings = []
    kernels = installed_kernels()
    for module in spec.get("required", []):
        for kernel in kernels:
            if not module_available(module, kernel):
                warnings.append(f"required module {module} is missing for kernel {kernel}")
    loaded = loaded_modules()
    running = os.uname().release
    for module in spec.get("required", []):
        if module not in loaded and not module_builtin(module, running):
            warnings.append(f"required module {module} is not loaded")
    for module, source in autoload_entries().items():
        if not module_available(module, running):
            warnings.append(f"{source} autoloads {module}, which does not exist for {running} (fails every boot)")
        if module in spec.get("unwanted_autoload", []):
            warnings.append(f"{source} autoloads {module}, which this machine should not load")
    if shutil.which("dkms"):
        rows = parse_dkms_status(subprocess.run(["dkms", "status"], text=True, capture_output=True).stdout)
        for name in sorted({row[0] for row in rows}):
            built = {row[1] for row in rows if row[0] == name and row[2].startswith("installed")}
            for kernel in kernels:
                if kernel not in built:
                    warnings.append(f"DKMS module {name} is not built for kernel {kernel}")
    return warnings


def module_builtin(name, kernel):
    builtin = read_text(Path("/usr/lib/modules") / kernel / "modules.builtin") or ""
    return any(Path(line).name.split(".ko")[0].replace("-", "_") == name for line in builtin.splitlines())


# IA32_PACKAGE_THERM_STATUS log bits stay set until cleared; we only read them.
PACKAGE_THERM_STATUS = 0x1B1
THROTTLE_LOG_BITS = {1: "thermal", 3: "PROCHOT", 5: "critical temperature", 11: "power limit"}


def throttle_reasons(value):
    return [name for bit, name in THROTTLE_LOG_BITS.items() if value >> bit & 1]


def read_package_therm_status():
    try:
        with open("/dev/cpu/0/msr", "rb") as msr:
            msr.seek(PACKAGE_THERM_STATUS)
            return int.from_bytes(msr.read(8), "little")
    except OSError:
        return None


def dirty_ntfs_messages():
    if shutil.which("journalctl") is None:
        return []
    result = subprocess.run(["journalctl", "-k", "-b", "-q", "--no-pager", "-g", "ntfs3.*dirty"], text=True, capture_output=True)
    return sorted({line.split("ntfs3(")[1].split(")")[0] for line in result.stdout.splitlines() if "ntfs3(" in line})


def systemctl_is_active(unit):
    if shutil.which("systemctl") is None:
        return "unknown"
    result = subprocess.run(["systemctl", "is-active", unit], text=True, capture_output=True)
    if result.stdout.strip():
        return result.stdout.strip()
    return "unknown" if result.returncode != 0 else "inactive"


def systemctl_is_enabled(unit):
    if shutil.which("systemctl") is None:
        return "unknown"
    result = subprocess.run(["systemctl", "is-enabled", unit], text=True, capture_output=True)
    if result.stdout.strip():
        return result.stdout.strip()
    return "unknown" if result.returncode != 0 else "disabled"


def pacman_installed(package):
    if shutil.which("pacman") is None:
        return False
    result = subprocess.run(["pacman", "-Q", package], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def installed_conflict_packages(profile):
    return [package for package in profile["conflicts"]["packages"] if pacman_installed(package)]


def loaded_modules():
    modules = set()
    text = read_text("/proc/modules")
    if not text:
        return modules
    for line in text.splitlines():
        parts = line.split()
        if parts:
            modules.add(parts[0])
    return modules


def cleanup_conflicts(runner, profile, force=False, unload_modules=False, remove_packages=False):
    require_supported_machine(profile, force=force)

    for unit in profile["conflicts"]["systemd_units"]:
        active = systemctl_is_active(unit)
        enabled = systemctl_is_enabled(unit)
        if active == "active" or enabled not in ("disabled", "not-found", "masked", "unknown"):
            runner.run(["systemctl", "disable", "--now", unit])
        runner.run(["systemctl", "reset-failed", unit], warn_on_failure=False)

    modules = loaded_modules()
    if unload_modules:
        for module in profile["conflicts"].get("modules", []):
            if module in modules:
                runner.run(["modprobe", "-r", module])
    else:
        stale_modules = [module for module in profile["conflicts"].get("modules", []) if module in modules]
        for module in stale_modules:
            runner.warn(f"obsolete module is loaded but was not unloaded without --unload-modules: {module}")

    packages = installed_conflict_packages(profile)
    if packages and remove_packages:
        runner.run(["pacman", "-Rns", *packages])
    else:
        for package in packages:
            runner.warn(f"conflicting package is installed but was not removed without --remove-packages: {package}")


# Fan RPM: thinkpad_acpi's hwmon reports garbage on this Legion. The firmware publishes real RPM through the
# Lenovo "Other Method" WMI interface (GetFeatureValue, method 17; feature 0x04030001/2 = FANS*100), the same path
# LenovoLegionLinux uses for this model (ACCESS_METHOD_WMI3). acpi_call lets root invoke it read-only.
ACPI_CALL = Path("/proc/acpi/call")
WMI_GET_FEATURE_VALUE = 17
FAN_FEATURES = {"fan1": 0x04030001, "fan2": 0x04030002}


def parse_acpi_call(text):
    text = text.strip().rstrip("\x00").strip()
    if text.startswith("0x"):
        return int(text, 16)
    if text.startswith("{") and text.endswith("}"):
        values = [int(v, 16) for v in text[1:-1].replace(" ", "").split(",") if v]
        return int.from_bytes(bytes(values[:4]), "little")
    return None  # "Error: ..." or "not called"


def wmi_other_get(profile, feature_id):
    method = profile["paths"].get("wmi_other_method")
    if not method or not os.access(ACPI_CALL, os.W_OK):
        return None
    ACPI_CALL.write_text(f"{method} 0 {WMI_GET_FEATURE_VALUE} b{feature_id.to_bytes(4, 'little').hex()}")
    return parse_acpi_call(ACPI_CALL.read_text())


def fan_rpm(profile):
    return {name: wmi_other_get(profile, feature) for name, feature in FAN_FEATURES.items()}


def nvidia_power_limit():
    if shutil.which("nvidia-smi") is None:
        return None
    result = subprocess.run(
        ["nvidia-smi", "--query-gpu=power.limit", "--format=csv,noheader,nounits"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode == 0 and result.stdout.strip():
        value = result.stdout.strip().splitlines()[0].strip()
        if value and not value.startswith("["):
            return value

    result = subprocess.run(
        ["nvidia-smi", "-q", "-d", "POWER"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        return None
    match = re.search(r"Current Power Limit\s*:\s*([0-9.]+)\s*W", result.stdout)
    return match.group(1) if match else None


def rapl_status_lines():
    lines = []
    for zone in powercap_package_zones():
        lines.append(f"{zone.name} ({read_text(zone / 'name')}):")
        for name_file in sorted(zone.glob("constraint_*_name")):
            index = name_file.name.split("_")[1]
            name = read_text(name_file)
            limit = read_text(zone / f"constraint_{index}_power_limit_uw")
            window = read_text(zone / f"constraint_{index}_time_window_us")
            suffix = f", window={window}us" if window is not None else ""
            lines.append(f"  {name}: {limit}uW{suffix}")
    return lines


def cpufreq_values(filename):
    values = {}
    root = Path("/sys/devices/system/cpu/cpufreq")
    for policy in sorted(root.glob("policy*")):
        value = read_text(policy / filename)
        if value is not None:
            values[policy.name] = value
    return values


def summarize_values(values):
    summary = {}
    for value in values.values():
        summary[value] = summary.get(value, 0) + 1
    return ", ".join(f"{key}={count}" for key, count in sorted(summary.items())) or "none"


