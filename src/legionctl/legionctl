    print(f"intel_pstate.max_perf_pct: {read_text('/sys/devices/system/cpu/intel_pstate/max_perf_pct')}")
    print(f"processor.ignore_ppc: {read_text('/sys/module/processor/parameters/ignore_ppc')}")
    print(f"cpufreq.governors: {summarize_values(cpufreq_values('scaling_governor'))}")
    print(f"cpufreq.epp: {summarize_values(cpufreq_values('energy_performance_preference'))}")

    print("rapl:")
    for line in rapl_status_lines():
        print(f"  {line}")

    print(f"nvidia_power_limit_w: {nvidia_power_limit()}")
    fans = fan_rpm(profile)
