def cmd_apply(args):
    profile, _ = load_profile(args.profile)
    runner = Runner(dry_run=args.dry_run, quiet=args.quiet)
    mode = apply_mode(runner, profile, args.mode, force=args.force, reassert=False, keep_override=args.keep_override)
    runner.info(f"applied {mode} policy")
    return 0


def cmd_gpu(args):
    outputs = gpu_outputs()
    if args.action == "status":
        print(f"gpu_mode: {gpu_mode(outputs)}")
        print(f"desktop GPU preference: {preferred_primary_gpu()} (Mutter reads it at login)")
        for name, card, driver, connected in outputs:
            print(f"  {name}: {card} ({driver}) {'connected' if connected else '-'}")
        return 0
    if args.choice is None:
        raise RuntimeError("gpu primary needs nvidia, intel or auto")
    runner = Runner(dry_run=args.dry_run)
    if args.choice == "auto":
        if PRIMARY_GPU_RULE.exists() and not args.dry_run:
            PRIMARY_GPU_RULE.unlink()
        runner.info(f"removed {PRIMARY_GPU_RULE}; Mutter picks the GPU of the built-in panel")
    elif args.dry_run:
        runner.info(f"would write {PRIMARY_GPU_RULE}:\n{primary_gpu_rule(args.choice)}")
    else:
        PRIMARY_GPU_RULE.write_text(primary_gpu_rule(args.choice))
        runner.info(f"wrote {PRIMARY_GPU_RULE}")
    runner.run(["udevadm", "control", "--reload"])
    runner.run(["udevadm", "trigger", "--subsystem-match=drm"])
    runner.info("log out and back in for GNOME to draw the desktop on the new GPU")
    return 0


def cmd_run(args):
    cmd = args.cmd[1:] if args.cmd[:1] == ["--"] else args.cmd
    if not cmd:
        raise RuntimeError("usage: legionctl run [--gpu nvidia|intel] [--cores p|e] [--nice N] -- command ...")
    env = {**os.environ, **gpu_env(args.gpu)}
    if args.nice is not None:
        # `nice -n` is relative to the caller's niceness; make --nice the absolute value the program gets
        cmd = ["nice", "-n", str(args.nice - os.nice(0)), *cmd]
    if args.cores != "all":
        cpus = cpu_class_cpus(args.cores)
        if not cpus:
            raise RuntimeError("this CPU does not report performance/efficiency core groups")
        # a transient scope pins the program and everything it starts; keep `$` in the command literal
        cmd = ["systemd-run", "--user", "--scope", "--quiet", "--expand-environment=no", "-p", f"AllowedCPUs={cpus}", "--", *cmd]
    os.execvpe(cmd[0], cmd, env)


def cmd_reassert(args):
    profile, _ = load_profile(args.profile)
    runner = Runner(dry_run=args.dry_run, quiet=args.quiet)
    mode = apply_mode(runner, profile, args.mode, force=args.force, reassert=True)
    runner.info(f"reasserted {mode} firmware policy")
    return 0


PPD_PROFILES = ("performance", "balanced", "power-saver")


def validate_profile(profile):
    errors = []
    for key in ("id", "paths", "conflicts"):
        if key not in profile:
            errors.append(f"missing top-level key {key!r}")
    modes = [mode for mode in ("ac", "battery") if isinstance(profile.get(mode), dict)]
    for mode in ("ac", "battery"):
        if mode not in modes:
            errors.append(f"missing {mode!r} section")
    for mode in modes:
        for block in ("rapl", "cpu", "firmware"):
            if block not in profile[mode]:
                errors.append(f"{mode}.{block} is missing")
        wanted = profile[mode].get("power_profile")
        if wanted is not None and wanted not in PPD_PROFILES:
            errors.append(f"{mode}.power_profile {wanted!r} is not one of {', '.join(PPD_PROFILES)}")
    # every policy knob must be set for both power sources, or a mode switch leaves the other's value behind
    if len(modes) == 2:
        for block in ("cpu", "firmware", "firmware_attributes"):
            drift = set(profile["ac"].get(block, {})) ^ set(profile["battery"].get(block, {}))
            if drift:
                errors.append(f"{block} keys differ between ac and battery: {', '.join(sorted(drift))}")
        if ("power_profile" in profile["ac"]) != ("power_profile" in profile["battery"]):
            errors.append("power_profile must be set for both ac and battery or neither")
    for firmware_mode, follow in profile.get("firmware_follow", {}).items():
        if follow.get("power_profile") not in (None, *PPD_PROFILES):
            errors.append(f"firmware_follow.{firmware_mode}.power_profile {follow.get('power_profile')!r} is not a PPD profile")
        if follow.get("governor") not in (None, "performance", "powersave"):
            errors.append(f"firmware_follow.{firmware_mode}.governor {follow.get('governor')!r} is not performance/powersave")
    for mode in modes:
        for choice in profile[mode].get("firmware", {}).get("platform_profile_preference", []):
            if "firmware_follow" in profile and choice not in profile["firmware_follow"]:
                errors.append(f"{mode} platform_profile {choice!r} has no firmware_follow entry")
    for scope, values in [("sysctl", profile.get("sysctl", {}))] + [(f"{m}.sysctl", profile[m].get("sysctl", {})) for m in modes]:
        for key, value in values.items():
            if not isinstance(value, str):
                errors.append(f"{scope}.{key} must be a string, got {type(value).__name__}")
    return errors


def cmd_follow(args):
    profile, _ = load_profile(args.profile)
    runner = Runner(dry_run=args.dry_run, quiet=args.quiet)
    current = read_text(profile["paths"]["platform_profile"])
    if current is None:
        runner.warn("platform_profile is not readable")
        return 1
    override = firmware_override()
    if current == (override or read_text(WRITTEN_FILE)):
        runner.info(f"platform_profile {current!r} is already the active policy; nothing to follow")
        return 0
    runner.info(f"following firmware mode {current!r} (Fn+Q)")
    save_state(runner, OVERRIDE_FILE, current)
    apply_follow_policy(runner, profile, current)
    return 0


def cmd_validate(args):
    profile, profile_path = load_profile(args.profile)
    errors = validate_profile(profile)
    for error in errors:
        print(f"- {error}")
    print(f"validate: {'failed' if errors else 'ok'} ({profile_path})")
    return 1 if errors else 0


def cmd_cleanup(args):
    profile, _ = load_profile(args.profile)
    runner = Runner(dry_run=args.dry_run, quiet=args.quiet)
    cleanup_conflicts(
        runner,
        profile,
        force=args.force,
        unload_modules=args.unload_modules,
        remove_packages=args.remove_packages,
    )
    runner.info("cleanup completed")
    return 0


