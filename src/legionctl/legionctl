        print("dmi: mismatch")
        for key, expected, actual in mismatches:
            print(f"  {key}: expected {expected!r}, got {actual!r}")
    else:
        print("dmi: match")
    print(f"firmware_override: {firmware_override() or 'none (profile defaults)'}")
    live_dmi = read_dmi()
    print(f"bios_version: {live_dmi.get('bios_version')}")
    print(f"bios_release: {live_dmi.get('bios_release')}")
    print(f"ec_firmware_release: {live_dmi.get('ec_firmware_release')}")
    print(f"board_name: {live_dmi.get('board_name')}")

    print(f"ac_online: {is_ac_online(profile)}")
    print(f"platform_profile: {read_text(profile['paths']['platform_profile'])}")
