    else:
        print("fan_rpm: unknown (needs root and the acpi_call module)")
    limits = firmware_attributes_status()
    if limits:
        print("firmware_limits: " + " ".join(f"{k}={v['current_value']}" for k, v in limits.items()))
    therm = read_package_therm_status()
