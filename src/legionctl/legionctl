        print(f"unit {unit}: active={systemctl_is_active(unit)} enabled={systemctl_is_enabled(unit)}")

    modules = loaded_modules()
    interesting = [
        "ideapad_laptop",
        "lenovo_wmi_gamezone",
        "lenovo_wmi_events",
        "thinkpad_acpi",
        "legion_laptop",
        "lenovo_legion",
    ]
    print("modules:")
    for module in interesting:
        print(f"  {module}: {'loaded' if module in modules else 'not-loaded'}")


def print_capabilities(profile):
