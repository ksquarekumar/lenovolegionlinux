#!/usr/bin/env python3
"""Toggle the built-in panel between its highest refresh rate and ~60 Hz (Fn+R), keeping the rest of the layout.

Runs in the user's GNOME session (bound to Fn+R via a GNOME shortcut). Talks to Mutter's DisplayConfig D-Bus API,
so it works on Wayland and only offers modes the panel actually reports at its current resolution.
"""

import argparse
import os
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

BUS_NAME = "org.gnome.Mutter.DisplayConfig"
OBJECT_PATH = "/org/gnome/Mutter/DisplayConfig"
VERIFY, TEMPORARY, PERSISTENT = 0, 1, 2
LOW_HZ = 60.0
# one Fn+R press makes the firmware emit a burst of key events (~10 within ~1 s); act on the first only
DEBOUNCE_S = 1.5


def debounced(stamp, now, window=DEBOUNCE_S):
    """True if a toggle already ran within `window` seconds; otherwise record `now` and return False."""
    try:
        if now - float(stamp.read_text()) < window:
            return True
    except (OSError, ValueError):
        pass
    stamp.write_text(f"{now}\n")
    return False


def refresh_kind(mode):
    return mode[6].get("refresh-rate-mode", "fixed")


def current_mode(modes):
    return next((m for m in modes if m[6].get("is-current")), None)


def pick_target(modes, current):
    # stay at the current resolution and keep VRR on or off as it is
    same_size = [m for m in modes if (m[1], m[2]) == (current[1], current[2]) and refresh_kind(m) == refresh_kind(current)]
    highest = max(same_size, key=lambda m: m[3])
    if abs(current[3] - highest[3]) > 0.5:
        return highest
    return min(same_size, key=lambda m: abs(m[3] - LOW_HZ))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--connector", help="monitor to toggle (default: the built-in eDP panel)")
    parser.add_argument("--dry-run", action="store_true", help="ask Mutter to verify the new layout without applying it")
    args = parser.parse_args(argv)
    stamp = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "legion-refresh-toggle.last"
    if not args.dry_run and debounced(stamp, time.time()):
        return 0

    proxy = Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None, BUS_NAME, OBJECT_PATH, BUS_NAME, None
    )
    serial, monitors, logical_monitors, _ = proxy.call_sync("GetCurrentState", None, Gio.DBusCallFlags.NONE, -1, None).unpack()

    modes_by_connector = {spec[0]: modes for spec, modes, _ in monitors}
    target_connector = args.connector or next((c for c in modes_by_connector if c.startswith("eDP")), None)
    active = {spec[0] for lm in logical_monitors for spec in lm[5]}
    if target_connector not in active:
        print(f"{target_connector or 'built-in panel'} is not active; nothing to toggle")
        return 0

    current = current_mode(modes_by_connector[target_connector])
    if current is None:
        print(f"{target_connector} has no current mode", file=sys.stderr)
        return 1
    target = pick_target(modes_by_connector[target_connector], current)

    config = []
    for x, y, scale, transform, primary, specs, _ in logical_monitors:
        members = []
        for spec in specs:
            connector = spec[0]
            mode = target if connector == target_connector else current_mode(modes_by_connector[connector])
            members.append((connector, mode[0], {}))
        config.append((x, y, scale, transform, primary, members))

    # temporary: applies without GNOME's "Keep these display settings?" dialog (persistent changes always ask);
    # the saved layout returns on re-login or monitor hotplug
    method = VERIFY if args.dry_run else TEMPORARY
    proxy.call_sync(
        "ApplyMonitorsConfig",
        GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})", (serial, method, config, {})),
        Gio.DBusCallFlags.NONE,
        -1,
        None,
    )
    verb = "would switch" if args.dry_run else "switched"
    print(f"{verb} {target_connector}: {current[3]:.0f} Hz -> {target[3]:.0f} Hz ({target[0]})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
