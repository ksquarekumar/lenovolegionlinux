{
  "description": "legionctl hooks: hook actions per event (manage them with /legionctl:hooks), the dossier gate and the dossier write guard",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "legionctl hook session-start", "timeout": 30 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "legionctl hook prompt", "timeout": 30 }] }],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "legionctl hook pre-tool", "timeout": 10 }]
      }
    ],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "legionctl hook session-end", "timeout": 10 }] }]
  }
}
