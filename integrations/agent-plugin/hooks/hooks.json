{
  "description": "legionctl hooks: hook actions per event (manage them with /legionctl:hooks), the dossier gate, the dossier write guard, thread delivery and tool records, and the team mode hooks of a lead",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "legionctl hook session-start", "timeout": 30 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "legionctl hook prompt", "timeout": 30 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "legionctl hook pre-tool", "timeout": 10 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "legionctl hook post-tool", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "legionctl hook stop", "timeout": 30 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "legionctl hook session-end", "timeout": 10 }] }],
    "TeammateIdle": [{ "hooks": [{ "type": "command", "command": "legionctl hook teammate-idle", "timeout": 10 }] }],
    "TaskCompleted": [{ "hooks": [{ "type": "command", "command": "legionctl hook task-completed", "timeout": 10 }] }]
  }
}
