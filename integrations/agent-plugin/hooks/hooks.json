{
  "description": "Run the legionctl hook actions bound to each event (manage them with /legionctl:hooks or `legionctl hooks`)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "legionctl hooks run --event session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "legionctl hooks run --event prompt",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
