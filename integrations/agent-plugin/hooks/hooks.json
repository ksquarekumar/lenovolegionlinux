{
  "description": "Inject legion reminders (skills to follow, habits), and tell the agent about machine load and setup gaps",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "legion reminders emit --event session-start",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "legion load --brief",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "legion setup --check --brief",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "legion reminders emit --event prompt",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "legion load --brief --only-busy",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
