{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team",
  "description": "A team file (`teams/<name>.jsonc`): the members of a thread and the flow between them.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "name": {
      "type": "string"
    },
    "members": {
      "description": "Member name -> its layer: `agent` names a config or an archetype; the other fields narrow it.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AgentConfig"
      }
    },
    "flow": {
      "$ref": "#/$defs/Flow",
      "default": {
        "may": {},
        "gates": {},
        "stop": [],
        "restart": {
          "max": 3,
          "within": "1h"
        },
        "rules": []
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "members"
  ],
  "$defs": {
    "AgentConfig": {
      "description": "One layer of an agent: a config (`agents.configs.<name>`, which names its `archetype`) or a team member (which\nnames its config or archetype with `agent`). Each field is optional; a layer sets only what it changes.",
      "type": "object",
      "properties": {
        "archetype": {
          "description": "A config: its archetype (`main-agent`, `thread-observer`, `ui-composer`).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "agent": {
          "description": "A team member: the config (or archetype) that it uses.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "harness": {
          "description": "The harness that this config is for; none: both.",
          "anyOf": [
            {
              "$ref": "#/$defs/Harness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "account": {
          "description": "An `agents accounts` profile.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tools": {
          "$ref": "#/$defs/ToolRules",
          "default": {
            "allow": [],
            "deny": []
          }
        },
        "skills": {
          "description": "Skills to add (names of legionctl skills).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "mcp": {
          "description": "MCP servers to add: `legionctl` or names in `mcp.servers`.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "commands": {
          "$ref": "#/$defs/CommandRules",
          "default": {
            "allow": [],
            "deny": [],
            "ask": []
          }
        },
        "instructions": {
          "description": "Instruction files to add (`~/` is the home; a relative path is from the repository root).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "pace": {
          "description": "`on-trigger`, `on-stop` or `on-declare`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "budget": {
          "$ref": "#/$defs/AgentBudget",
          "default": {
            "tokens_per_day": null,
            "wake_tokens": null,
            "wake_seconds": null
          }
        },
        "sandbox": {
          "description": "Codex sandbox mode of an operator session.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "approval": {
          "description": "Codex approval policy of an operator session.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "route": {
          "description": "What answers a wake of an operator member, in order (todo-138): `rlcd` (a System One decision on the events;\nescalate wakes the next step with its answer as a brief) and `acp` (the member's session). A step that is not\nconfigured is skipped; a step that fails is reported, and the next step does not run in its place. None:\n`acp`.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "rlcd": {
          "description": "The rlcd step of the route.",
          "anyOf": [
            {
              "$ref": "#/$defs/MemberRlcd"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capabilities": {
          "description": "Capability sets it requests at its start (DESIGN-13); a higher layer may only narrow them.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "Harness": {
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "ToolRules": {
      "description": "Tools the agent may call (`allow`, empty: each tool) and may not call (`deny`).",
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "CommandRules": {
      "description": "Command patterns (`Bash(cargo publish*)`) the agent may run, may not run, and runs only after a person agrees.",
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "ask": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "AgentBudget": {
      "description": "Token and time limits: per day, and per wake of a member that sleeps until a trigger.",
      "type": "object",
      "properties": {
        "tokens_per_day": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "wake_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "wake_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false
    },
    "MemberRlcd": {
      "description": "A member's rlcd step: its backend (none: `rlcd.backend`) and questions. The question `action` (a choice of\nignore, note and escalate) decides; with `escalate_at`, an escalate probability of at least that percent escalates\ntoo.",
      "type": "object",
      "properties": {
        "backend": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "questions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Question"
          }
        },
        "escalate_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "questions"
      ]
    },
    "Question": {
      "description": "One typed question.",
      "oneOf": [
        {
          "description": "One of the options; option -> its meaning.",
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string"
            },
            "options": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "choice"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "instructions",
            "options"
          ]
        },
        {
          "description": "The probability of yes (System One `noul`, `OpenAI` `predicate`).",
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "yesno"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "instructions"
          ]
        },
        {
          "description": "A number.",
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "score"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "instructions"
          ]
        }
      ]
    },
    "Flow": {
      "type": "object",
      "properties": {
        "may": {
          "description": "Member -> the message kinds it may send; only kinds that its archetype may send.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        },
        "gates": {
          "description": "Gate -> its conditions, each `<member>: no open hard-block` or `<member>: result <first words>`. Gates:\n`checkpoint` (`workspace checkpoint` of the main agent), `declare:done` (`thread declare done`),\n`task:completed` (a teammate's task in team mode).",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        },
        "stop": {
          "description": "When the pool ends (its members end, its log stays): `main0 ended` (the main agent's session ended),\n`declare:done` (main0 declared done and the gate passed). With `budget`, a member that used its\n`budget.tokens_per_day` gets no wake until the next day.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "restart": {
          "description": "How often a member whose wake failed starts again; past it, the member fails and its blocks expire.",
          "$ref": "#/$defs/Restart",
          "default": {
            "max": 3,
            "within": "1h"
          }
        },
        "rules": {
          "description": "Watch rules that the operator adds at the start: a member watches another, and a call of `tools` on `path`\nwith no Bash command that contains `expect` before the reply ends (the stop) is a miss that wakes it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlowRule"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "Restart": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 3
        },
        "within": {
          "description": "`<n>s`, `<n>m` or `<n>h`.",
          "type": "string",
          "default": "1h"
        }
      },
      "additionalProperties": false
    },
    "FlowRule": {
      "type": "object",
      "properties": {
        "member": {
          "description": "The member that watches and does the step (or nudges).",
          "type": "string"
        },
        "watched": {
          "type": "string",
          "default": "main0"
        },
        "tools": {
          "type": "string",
          "default": "Edit|Write|MultiEdit|NotebookEdit"
        },
        "path": {
          "type": "string",
          "default": ""
        },
        "expect": {
          "description": "The Bash command that the watched member should run (`make lint`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "member",
        "expect"
      ]
    }
  }
}
