<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>legionctl</vendor>

  <action id="org.legionctl.power.apply">
    <description>Apply the power policy</description>
    <message>Authentication is required to apply the power policy</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.gpu.primary">
    <description>Choose the GPU that draws the desktop</description>
    <message>Authentication is required to choose the GPU that draws the desktop</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.knobs.hold">
    <description>Hold a machine setting at a value, or release it</description>
    <message>Authentication is required to hold or release a machine setting</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.rules">
    <description>Change the system power rules (configset layers)</description>
    <message>Authentication is required to change the system power rules</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.windows.vm">
    <description>Start the installed Windows in a virtual machine, or end it</description>
    <message>Authentication is required to give the Windows disk to a virtual machine</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.battery">
    <description>Change the battery's charge mode or USB charging while off</description>
    <message>Authentication is required to change how the battery charges</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.boot">
    <description>Add, confirm, rebuild or remove legionctl's boot entry (systemd-boot and signed kernel images)</description>
    <message>Authentication is required to change how the computer starts</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.greeter">
    <description>Put legionctl's greeter (greetd) in place of GDM, or GDM back</description>
    <message>Authentication is required to change the login screen</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- the greeter's choices before login; nobody by default: 50-legionctl-greeter.rules allows greetd's user greeter -->
  <action id="org.legionctl.greeter.act">
    <description>Change the Windows VM, the Windows disk or the NVIDIA GPU of a user before login</description>
    <message>Only the login screen can change the Windows VM, the Windows disk or the GPU before login</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.vfio">
    <description>Give a GPU or a disk controller to a virtual machine, or give it back</description>
    <message>Authentication is required to give a device to a virtual machine</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.legionctl.cleanup">
    <description>Disable conflicting services and unload conflicting kernel modules</description>
    <message>Authentication is required to disable conflicting services and modules</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.legionctl.tune">
    <description>Step a firmware power limit through values under load</description>
    <message>Authentication is required to tune the firmware power limits</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.legionctl.fan">
    <description>Change the fan curve, fan max mode or full fan speed</description>
    <message>Authentication is required to change the fan control</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <!-- a raw EC write that can stop fan control: no kept authorization -->
  <action id="org.legionctl.fan.lock">
    <description>Lock or release the EC fan controller</description>
    <message>Authentication is required to write the EC fan lock</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.legionctl.windows.reboot">
    <description>Restart into Windows once</description>
    <message>Authentication is required to restart the computer into Windows</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
