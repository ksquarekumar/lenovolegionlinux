[Unit]
Description=legionctl machine daemon (power policy, Fn keys, D-Bus API)
After=power-profiles-daemon.service nvidia-persistenced.service dbus.service
# three failures in five minutes: stop restarting and hand the machine to the firmware (note 13)
StartLimitIntervalSec=300
StartLimitBurst=3
OnFailure=legionctl-safe.service

[Service]
Type=notify
ExecStart=/usr/lib/legionctl/legionctl-system
Restart=on-failure
RestartSec=2
StateDirectory=legionctl
RuntimeDirectory=legionctl
RuntimeDirectoryPreserve=yes
# read-only except the files that the features write; pacman, ukify, sbsign and efibootmgr changes run as transient units
# (docs/design/13-daemon.md, Sandbox). The ESP is at /efi (may not exist), /boot or /boot/efi (under /boot).
ProtectSystem=strict
ConfigurationDirectory=legionctl
ReadWritePaths=/etc/udev/rules.d /etc/polkit-1/rules.d /etc/greetd -/efi /boot

[Install]
WantedBy=multi-user.target
