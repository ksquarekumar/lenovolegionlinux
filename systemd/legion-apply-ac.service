[Unit]
Description=Apply local Legion AC performance policy
After=power-profiles-daemon.service nvidia-persistenced.service nvidia-powerd.service
Wants=nvidia-persistenced.service nvidia-powerd.service
ConditionACPower=true

[Service]
Type=oneshot
ExecStart=/usr/bin/legionctl apply ac --quiet

[Install]
WantedBy=legion-ac.target
