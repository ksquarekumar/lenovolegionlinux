    { "id": "S4", "kind": "requirement", "text": "gpu power off is refused before polkit while a program uses the GPU; undo keeps it powered again.", "objectives": ["O4"],
      "tests": ["test:crates/legionctl/tests/machine.rs::the_nvidia_gpu_sleeps_only_when_no_program_uses_it_and_undo_keeps_it_powered_again"] }
