{
  "$schema": "../feature.schema.json",
  "id": "quality",
  "title": "Codebase quality: one helper per concept, no dead migration, clean crate edges, smaller files",
  "status": "planned",
  "plan_rows": ["legionctl#todo-154"],
  "objectives": [
    { "id": "O1", "text": "One implementation per concept (git runner, keyring, now, home, atomic write, spawn context)." },
    { "id": "O2", "text": "No code for a migration that has run; legionctl-core does not depend on legionctl-machine." },
    { "id": "O3", "text": "No source or test file mixes unrelated areas; each split keeps behaviour and tests." }
  ],
  "stories": [
    { "id": "S1", "kind": "requirement", "text": "Two writers of one config file never leave a mixed or a lost file (one atomic_write with a unique temporary name). Variations: V1 two agents set at once (success: one of the two whole files); V2 a write that fails half way (success: the old file stays).", "objectives": ["O1"],
      "tests": ["test:crates/legionctl/tests/agents.rs::two_writers_of_one_config_file_never_leave_a_mixed_or_lost_file"] },
    { "id": "S2", "kind": "requirement", "text": "Without HOME the operator and the CLI refuse with 'HOME is not set' (one home()); no path falls back to '/'. Variations: V1 HOME empty (failure: same refusal).", "objectives": ["O1"],
      "tests": ["test:crates/legionctl/tests/e2e.rs::without_home_the_operator_and_the_cli_refuse_and_write_nothing_under_root"] },
    { "id": "S3", "kind": "requirement", "text": "Every secret-tool read goes through one keyring module: the gateway, rlcd and session logins find the same entry and give one error text.", "objectives": ["O1"],
      "tests": ["test:crates/legionctl/tests/threads.rs::rlcd_ask_sends_each_wire_shape_and_fails_a_failed_call_at_once",
                "test:crates/legionctl/tests/gateway.rs::a_missing_provider_key_names_the_keyring_entry_for_each_caller"] },
    { "id": "S4", "text": "Dossier homes work without the migration: first use imports and links the home.", "objectives": ["O2"],
      "tests": ["test:crates/legionctl/tests/e2e.rs::the_first_use_in_a_repository_imports_its_agentworkspaces_folder_and_links_the_home"] },
    { "id": "S5", "text": "Config writes keep the user's file when it cannot be read, also after the helpers move into core.", "objectives": ["O2"],
      "tests": ["test:crates/legionctl/tests/agents.rs::setup_never_writes_over_a_codex_config_that_it_cannot_read"] },
    { "id": "S6", "kind": "requirement", "text": "After the splits each area keeps its tests: the full suite passes with the same test count and the moved tests keep their names.", "objectives": ["O3"],
      "tests": ["test:crates/legionctl/tests/code.rs::a_plan_is_checked_against_the_code_graph_and_a_commit_that_adds_its_units_completes_it",
                "test:crates/legionctl/tests/e2e.rs::the_checkpoint_gate_refuses_tests_without_evidence_and_takes_recorded_kills_and_accepts"] }
  ],
