  "objectives": [
    { "id": "O1", "text": "Build output and graph snapshots per repository, worktree and language have a size, an age and a safe cleanup." },
    { "id": "O2", "text": "Each language's tools are known (installed, version, path) and run when asked, or on change when a repository opts in." },
    { "id": "O3", "text": "A repository's tooling is a checked manifest: each install with its source, version and hashes, and a health check." },
    { "id": "O4", "text": "Builds and tests of many agents share the machine without stalls: one slot pool, impact-selected tests, low-weight slices." }
  ],
  "stories": [
    { "id": "S1", "kind": "lifecycle", "text": "workspace outputs lists target, node_modules, .venv and the others per worktree and language with size and age, and .graf/refs sizes; the cleanup shows a dry run first and keeps what a running build uses. Variations: V1 a cargo build runs in the worktree (success: its target is kept); V2 over the size limit (success: a doctor finding); V3 language coverage (success: the C files named as giving no facts).", "objectives": ["O1"],
      "tests": ["test:crates/legionctl/tests/checks.rs::build_outputs_are_listed_per_language_and_cleanup_keeps_what_a_running_build_uses"] },
    { "id": "S2", "kind": "control-flow", "text": "code tools list shows each tool of each language with version and path or missing; code tools run runs the formatter or linter on the changed files; on change only when the repository opted in. Variations: V1 no opt-in (success: the watcher only records unchecked files); V2 missing tool (failure: named with its install source, nothing run).", "objectives": ["O2"],
      "tests": ["test:crates/legionctl/tests/checks.rs::language_tools_run_on_request_and_on_change_only_with_the_repositorys_opt_in"] },
    { "id": "S3", "kind": "requirement", "text": "The tooling manifest is checked against its schema; each entry's version and hash are verified by its health check. Variations: V1 a curl|sh script whose hash changed (failure: refused, not run); V2 no manifest (success: an agent proposes one, the user approves before it is written).", "objectives": ["O3"],
      "tests": ["test:crates/legionctl/tests/checks.rs::a_tooling_manifest_entry_fails_its_check_when_its_hash_or_version_differs"] },
    { "id": "S4", "kind": "control-flow", "text": "Full builds and suites of several agents queue for the machine's slot pool; code tests run --impact runs only the tests that reach the changed entities; builds run in a low-weight slice. Variations: V1 pool full (success: queued with its place, no failure); V2 a change with no reaching test (success: says so, and the merge gate still runs the full suite).", "objectives": ["O4"],
      "tests": ["test:crates/legionctl/tests/e2e.rs::builds_of_several_agents_share_the_slot_pool_and_impact_runs_only_reaching_tests"] }
  ],
