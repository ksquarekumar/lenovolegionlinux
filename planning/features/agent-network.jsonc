      { "key": "op:thread.start", "change": "add" },
      { "key": "op:thread.send", "change": "add" },
      { "key": "op:thread.peers", "change": "add" }
    ] },
    { "id": "P6a", "text": "Archetype files, agent configs, agents check", "status": "planned", "stories": ["S4"], "depends_on": ["P5"], "units": [
