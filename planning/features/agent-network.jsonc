// Design 23, Parts B and B+ (todo-91, todo-97, todo-98): the main agent and observers in one durable thread.
{
  "$schema": "../feature.schema.json",
  "id": "agent-network",
  "title": "Agent network, presence and pools",
  "status": "done",
  "plan_rows": ["legionctl#todo-91", "legionctl#todo-97", "legionctl#todo-98", "legionctl#todo-120"],
  "objectives": [
    { "id": "O1", "text": "Observers remind, nudge and block the main agent through a durable outbox." },
    { "id": "O2", "text": "The main agent stays on the critical path; observers sleep until a trigger." }
  ],
  "stories": [
    { "id": "S1", "text": "An observer reminds main with the count, and a hard block stops the tool.", "objectives": ["O1"],
      "tests": ["test:crates/legionctl/tests/threads.rs::a_watch_rule_reminds_main_once_with_the_count_of_its_misses_and_wakes_only_on_its_trigger",
                "test:crates/legionctl/tests/threads.rs::blocks_hold_main_until_acked_and_only_an_observer_of_the_thread_sends_them",
                "test:crates/legionctl/tests/threads.rs::a_send_message_call_of_main_lands_in_the_thread_log"] },
    { "id": "S2", "text": "Peers see each other on a dossier and a message reaches an idle peer once.", "objectives": ["O1"],
      "tests": ["test:crates/legionctl/tests/threads.rs::the_outbox_survives_a_restart_and_peers_on_one_dossier_see_each_other_with_their_state"] },
    { "id": "S5", "text": "Each subagent of a session is a peer of its own, with its workspace, tool calls and messages.", "objectives": ["O1"],
      "tests": ["test:crates/legionctl/tests/threads.rs::the_subagents_of_one_session_are_peers_with_their_own_workspace_tool_calls_and_messages"] },
    { "id": "S3", "kind": "control-flow", "text": "vanilla wakes the observer on its events; a wake stops at its budget.", "objectives": ["O2"],
      "tests": ["test:crates/legionctl/tests/threads.rs::a_team_thread_wakes_its_observer_only_on_a_trigger_and_within_its_budget",
                "test:crates/legionctl/tests/threads.rs::the_observer_backfills_only_while_main_is_idle_and_the_flow_gates_done",
                "test:crates/legionctl/tests/threads.rs::an_operator_restart_restores_the_members_and_a_cut_off_wake_goes_on",
                "test:crates/legionctl/tests/threads.rs::a_failed_member_restarts_within_its_limit_then_its_blocks_expire"] },
    { "id": "S4", "kind": "requirement", "text": "Each config field reaches the harness, or the config is refused.", "objectives": ["O2"],
      "tests": ["test:crates/legionctl/tests/agents.rs::vanilla_resolves_its_three_members_through_their_layers_and_a_layer_that_widens_is_refused",
                "test:crates/legionctl/tests/agents.rs::a_field_that_a_run_path_cannot_apply_refuses_the_member_and_names_the_field",
                "test:crates/legionctl/tests/agents.rs::setup_apply_writes_each_agent_config_as_a_codex_agent_with_instructions_model_and_effort_only",
                "test:crates/legionctl/tests/agents.rs::the_archetype_files_carry_only_the_frontmatter_fields_that_plugin_agents_honour"] },
    { "id": "S6", "kind": "requirement", "text": "A Claude lead runs the team as teammates; a lost teammate runs as an operator member.", "objectives": ["O1", "O2"],
      "tests": ["test:crates/legionctl/tests/threads.rs::a_claude_lead_runs_the_team_as_teammates_and_a_lost_one_restarts_as_an_operator_member",
                "test:crates/legionctl/tests/threads.rs::a_codex_lead_refuses_a_member_config_that_sets_its_own_sandbox"] }
  ],
