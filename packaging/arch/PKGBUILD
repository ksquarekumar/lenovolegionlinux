# Maintainer: ksquare
# shellcheck shell=bash disable=SC2034,SC2154  # makepkg reads these variables and provides $pkgdir
pkgname=legionctl
pkgver=0.2.0.r187.g79bf2fd
pkgrel=1
pkgdesc="Operator for the Lenovo Legion Pro 7 16IRX8H (82WQ): power policy daemon, session OSD and agent tooling"
arch=("x86_64")
url="https://github.com/ksquarekumar/lenovolegionlinux"
install=legionctl.install
license=("MIT" "GPL-2.0-only")
depends=("systemd" "systemd-libs" "dkms" "dbus" "polkit" "power-profiles-daemon" "cpupower" "nvidia-utils" "bubblewrap"
  "libxkbcommon" "libxkbcommon-x11" "libxcb" "wayland" "vulkan-icd-loader" "fontconfig" "sudo" "jq" "curl" "git")
makedepends=("git" "cargo" "clang" "docker")
# no GCC LTO for the C parts (bundled SQLite): with makepkg's lto, GCC's link step gives a false -Wstringop-overread
# in sqlite3Strlen30 (a path GCC thinks has a NULL pointer). Cargo's own release profile decides the Rust LTO
options=("!lto")
optdepends=(
  "gnome-shell: the legionctl-osd OSD extension"
  "rust: cargo, with which legionctl setup apply installs clauth (the account engine)"
  "docker: agent sessions in a container (legionctl workspace pack)"
  "qemu-base: agent sessions in a VM (legionctl workspace pack --as vm)"
  "virtiofsd: the folders of a VM session"
  "libisoburn: xorriso for the cloud-init seed of a VM disk"
  "edk2-ovmf: UEFI firmware of the Windows VM (legionctl windows vm)"
  "swtpm: the Windows VM's TPM"
  "virt-viewer: legionctl windows vm view (SPICE)"
  "systemd-ukify: legionctl boot install (signed kernel images)"
  "sbsigntools: legionctl boot install (signing with the MOK key)"
  "efibootmgr: legionctl boot and windows reboot (the firmware boot entries)"
  "greetd: legionctl greeter install (the login screen in place of GDM)"
  "cage: legionctl greeter install (the compositor of the login screen)"
  "noto-fonts: legionctl greeter install (the fonts of the login screen)"
  "stress-ng: the CPU workload of bench and tune"
  "scx-scheds: sched_ext schedulers (scx_lavd) for /etc/scx_loader.toml"
  "scx-tools: scx_loader service"
)
conflicts=("LenovoLegion" "lenovolegionlinux-git" "lenovolegionlinux-dkms-git" "lenovo-legion-wmi-dkms-git")
backup=("etc/scx_loader.toml")
source=()
sha256sums=()

pkgver() {
  local repo_root="${startdir}/../.."
  printf '0.2.0.r%s.g%s' "$(git -C "${repo_root}" rev-list --count HEAD)" "$(git -C "${repo_root}" rev-parse --short HEAD)"
}

# its own cargo folder: makepkg's RUSTFLAGS (target-cpu, mold) differ from a dev build's, which then keeps its cache
export CARGO_TARGET_DIR="${startdir}/../../target/package"

# all cores: the environment variable wins over `[build] jobs` of the user's ~/.cargo/config.toml (a limit for agents)
# LEGIONCTL_PKGVER: `legionctl --version` and `about` show this package version (0.2.0 r340)
build() {
  CARGO_BUILD_JOBS="$(nproc)" LEGIONCTL_PKGVER="${pkgver}" make -C "${startdir}/../.." build
}

package() {
  local repo_root="${startdir}/../.."
  make -C "${repo_root}" DESTDIR="${pkgdir}" install
  install -Dm644 "${repo_root}/README.md" "${pkgdir}/usr/share/doc/legionctl/README.md"
  install -Dm644 "${repo_root}/LICENSE" "${pkgdir}/usr/share/licenses/legionctl/LICENSE"
  install -Dm644 "${repo_root}/THIRD-PARTY-NOTICES.md" "${pkgdir}/usr/share/licenses/legionctl/THIRD-PARTY-NOTICES.md"
}
