post_install() {
  systemctl daemon-reload
  echo ":: enable the daemon:    systemctl enable --now legionctl-system.service scx_loader.service"
  echo ":: per user:             systemctl --user enable --now legionctl-operator.socket legionctl-operator.service"
  echo ":: OSD (next login):     gnome-extensions enable legionctl-osd@legionctl"
}

post_upgrade() {
  systemctl daemon-reload
  systemctl try-restart legionctl-system.service
  echo ":: per user:             systemctl --user daemon-reload && systemctl --user restart legionctl-operator.service"
}

pre_remove() {
  # the daemon's pinned eBPF sensors (they detach when the daemon stops)
  rm -rf /sys/fs/bpf/legionctl
  # GDM back in place of legionctl's greeter (legionctl greeter install), so the computer keeps a login screen
  /usr/lib/legionctl/legionctl-system --greeter-remove
  # the Windows VM's autostart rules, one for each user (legionctl windows vm autostart)
  rm -f /etc/polkit-1/rules.d/49-legionctl-windows-vm-*.rules
}
