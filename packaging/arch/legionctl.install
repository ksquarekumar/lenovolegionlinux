# The users that are logged in now (uid 1000 and up): their user managers get the steps at once, the others at their
# next login (the user units are enabled for every user with --global).
logged_in() {
  loginctl list-users --no-legend | awk '$1 >= 1000 { print $2 }'
}

# The daemon's binary in its one-shot modes (a test puts a stand-in in its place).
legionctl_system() {
  /usr/lib/legionctl/legionctl-system "$@"
}

post_install() {
  systemctl daemon-reload
  # the package turns legionctl on itself, so no step is left to type (EV-review-11 U-14)
  systemctl enable --now legionctl-system.service
  echo ":: on: legionctl-system, the machine daemon (off: sudo systemctl disable --now legionctl-system.service)"
  # scx_loader comes with the optional scx-tools
  if [ -e /usr/lib/systemd/system/scx_loader.service ]; then
    systemctl enable --now scx_loader.service
    echo ":: on: scx_loader, the CPU scheduler loader (off: sudo systemctl disable --now scx_loader.service)"
  fi
  systemctl --global enable legionctl-operator.socket legionctl-operator.service
  for user in $(logged_in); do
    systemctl --user -M "$user@" daemon-reload
    systemctl --user -M "$user@" start legionctl-operator.socket
  done
  echo ":: on: legionctl-operator, which the commands and the app of each user talk to (off: sudo systemctl --global disable legionctl-operator.socket legionctl-operator.service)"
  echo ":: As your user, run 'legionctl setup apply' once: it adds the OSD and the agent setup"
}

post_upgrade() {
  systemctl daemon-reload
  # legionctl's greeter, when it is the login screen, gets this version's greetd configuration and folder
  legionctl_system --greeter-update
  systemctl try-restart legionctl-system.service
  # each running operator restarts with the new build
  for user in $(logged_in); do
    systemctl --user -M "$user@" daemon-reload
    systemctl --user -M "$user@" try-restart legionctl-operator.service
  done
  echo ":: restarted: legionctl-system and the operator of each logged-in user, where they ran (an off service stays off)"
}

pre_remove() {
  systemctl --global disable legionctl-operator.socket legionctl-operator.service
  systemctl disable --now legionctl-system.service
  # the daemon's pinned eBPF sensors (they detach when the daemon stops)
  rm -rf /sys/fs/bpf/legionctl
  # GDM back in place of legionctl's greeter (legionctl greeter install), so the computer keeps a login screen
  legionctl_system --greeter-remove
  # the Windows VM's autostart rules, one for each user (legionctl windows vm autostart)
  rm -f /etc/polkit-1/rules.d/49-legionctl-windows-vm-*.rules
}
