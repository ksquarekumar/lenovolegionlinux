{
  "compilerOptions": {
    "target": "es2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["es2024"],
    "types": ["@girs/gnome-shell/ambient", "@girs/gnome-shell/extensions/global"]
  },
  "include": ["gnome-extension/**/*.js"]
}
