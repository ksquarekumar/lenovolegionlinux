// The help that legionctl shows for each setting (Settings, `legionctl config settings`, tooltips).
// One short sentence for the person who uses legionctl: what the setting does for them. A test checks that every
// setting has its help here and that no help names a setting that is gone.
{
  "config.precedence": "The order in which settings files apply, from the built-in defaults to the project.",
  "config.locked": "Settings that only this computer's administrator can change.",
  "config.approve": "Settings that a project can change only after you allow its files once.",

  "workspace.root": "The folder where legionctl makes the working copies of your projects.",
  "workspace.nudge": "When agents get a reminder to work in their own working copy.",

  "reminders": "Short notes that agents get at the start of a session or with each prompt.",
  "hooks.actions": "Commands that run when an agent starts, gets a prompt or ends.",
  "hooks.bindings": "Which hook commands run at which agent event.",

  "dossier.root": "The folder that keeps the notes, plans and records of your projects.",
  "dossier.gate": "Stop agents in a project with notes until they work with those notes.",
  "dossier.auto_bind": "Give an agent the project's last notes by itself when it starts.",
  "dossier.nudge": "When agents get a reminder to write their work into the notes.",
  "dossier.nudge_turns": "How many agent replies may change files before a reminder to write notes.",
  "dossier.stale_hours": "After how many idle hours another agent session can take over a session's notes.",
  "dossier.message_chars": "Long messages between agents get a hint to put the details into the notes.",
  "dossier.classes": "The kinds of records that notes can keep.",
  "dossier.immutable_classes": "Records that cannot change once they are written.",
  "dossier.plan_sections": "The sections of a project plan.",

  "session.agents": "The agents that legionctl can start, and how to start each.",
  "session.writable": "Agent files that a session may change; your real files stay as they are.",
