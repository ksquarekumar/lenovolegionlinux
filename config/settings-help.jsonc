  "gates.git.deny": "Git commands that agents may not run.",
  "mcp.servers": "Extra tool servers that agents get.",
  "packages": "Packages that legionctl can fetch for your projects.",

  "gateway.port": "The local port of the model gateway; 0 turns the port off.",
  "gateway.accounts": "The model accounts that the gateway can use.",
  "gateway.pool": "Which account serves each model, in order.",
