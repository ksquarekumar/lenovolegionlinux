  "session.resume": "How to continue an agent session that ended.",
  "session.acp": "How the app talks to each agent.",
  "session.acp_packages": "The program that legionctl installs for each agent connection.",
  "session.scope": "Keep each agent session in its own group of processes, so that you can pause or stop it.",
  "session.hidden": "Files and folders that agents can never see.",
  "session.skills": "Skills that every agent session gets.",
  "session.policy.idle_freeze_minutes": "Pause an agent session after it waits this many minutes for you; 0 never pauses.",
  "session.policy.offload_headless": "Pause background agent runs while the computer is busy.",
