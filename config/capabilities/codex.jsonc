// The harness Codex (DESIGN-12, needs table and harness profile). A session of agent "codex" requests this set by
// itself. Its own command sandbox is off (sandbox mode danger-full-access, user decision 2026-10-17): our sandbox, the
// environment and the gateway are the one boundary; its approval policy stays as the session sets it. The ACP adapter
// (codex-acp of the ACP project) takes no -c arguments: its mode agent-full-access is the same setting (sandbox
// danger-full-access, no approval asks and no auto review). Codex 0.163 on a ChatGPT login takes its backend from the
// login (an HTTPS origin; it reads no OPENAI_BASE_URL), so it reaches chatgpt.com through the gateway's tunnel
// (HTTPS_PROXY), to the hosts below only.
{
  "$schema": "../../docs/api/runnable.schema.json",
  "name": "codex",
  "version": 2,
  "description": "Codex in a legionctl session: the model API and the ChatGPT login refresh, the update check off, its own sandbox off.",
  "connections": {
    "out": [
      { "host": "chatgpt.com", "why": "the model backend of a ChatGPT login and its usage" },
      { "host": "api.openai.com", "why": "the model API of an API key" },
      { "host": "auth.openai.com", "why": "the ChatGPT login refresh (DESIGN-12 wall 1)" }
    ],
    "forbidden": ["ab.chatgpt.com", "api.github.com"],
    "mcp": ["legionctl"]
  },
  // a headless run starts its ACP adapter (session.acp) with bun's runtime: no Node.js
  "tools": [{ "name": "bun" }],
  "harness": {
    "agent": "codex",
    "versions": ">=0.160 <1",
    "model_apis": [
      { "host": "chatgpt.com", "shape": "openai-responses", "streaming": ["sse", "websocket"] },
      { "host": "api.openai.com", "shape": "openai-responses", "streaming": ["sse"] }
    ],
    "base_url_variables": [],
    "credentials": ["~/.codex/auth.json"],
    "telemetry": [
      { "host": "api.github.com", "args": ["-c", "check_for_update_on_startup=false"] }
    ],
    // after the agent's command (session.agents) and after the adapter of session.acp, which bun passes them to
    "args": ["-c", "sandbox_mode=\"danger-full-access\""],
    "env": { "INITIAL_AGENT_MODE": "agent-full-access" }
  }
}
