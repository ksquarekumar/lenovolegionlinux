// legionctl defaults: the lowest config layer, compiled into every legionctl binary.
//
// Layers, lowest first: these defaults, /etc/legionctl/*.jsonc (system), ~/.config/legionctl/*.jsonc (user),
// <repo>/.legionctl/*.jsonc (repository). Files in a layer merge in name order; in the user layer, managed.jsonc
// (written by `legionctl reminders` and `legionctl hooks`) merges last.
//
// Merge: objects merge per key; any other value replaces the lower one; `null` removes the key; "name+": [...]
// appends to the array "name". `legionctl config explain <key>` shows which file set a value.
{
  "config": {
    // Only these defaults and /etc/legionctl may set "config". Lowest first.
    "precedence": ["defaults", "system", "user", "repo"],
    // Keys or prefixes ("hooks.actions") that only the defaults and /etc/legionctl may set.
    "locked": []
  },

  "workspace": {
    // Workspaces (a dossier's operating directory in a repository) live in <root>/<repo>/<dossier>.
    "root": "/data/worktrees",
    // Tell the agent to open one: at session start when the dossier has none in this repository, and before a reply
    // ends when the main checkout has changes (decided 2026-10-13: a nudge, not a write block).
    "nudge": true
  },

  // Reminders that the hooks inject into agent sessions. Turn one on or off with "<id>": {"enabled": ...}.
  "reminders": {
    "ste100": {
      "text": "Write all user-facing text in ASD-STE100 Simplified Technical English (skill legionctl:ste100-style).",
      "event": "prompt",
      "enabled": true
    },
    "glanceable": {
      "text": "Structure user-facing output for a glance: answer first, then layered detail; exact identifiers; no repetition (skill legionctl:glanceable-style).",
      "event": "prompt",
      "enabled": true
    },
    "dossier-practice": {
      "text": "Keep this session's dossier current in the same turn: state in plan.md, detail in MEMORY, DESIGN and EVIDENCE (skill legionctl:dossier-practice).",
      "event": "prompt",
      "enabled": true
    },
    "load-aware": {
      "text": "Check the legionctl load (MCP tool `load`) before builds, test suites or parallel jobs, and scale them down when busy.",
      "event": "session-start",
      "enabled": false
    },
    "workspace": {
      "text": "Change code in the dossier's workspace (MCP tool workspace_open), not in the repository's own checkout.",
      "event": "session-start",
      "enabled": false
    }
  },

  "hooks": {
    // Your own actions: "<id>": {"command": "one-line shell command", "timeout": seconds (1-30)}.
    // Built-in actions: reminders, load, load-if-busy, setup-check.
    "actions": {},
    // What runs, in order, for each hook event.
    "bindings": {
      "session-start": ["reminders", "load", "setup-check"],
      "prompt": ["reminders", "load-if-busy"]
    }
  },

  // Dossiers (note 18): one writable dossier per agent session, in <root>/<dossier>/.
  "dossier": {
    "root": "~/.agentworkspace",
    // Block every prompt of a session that has no dossier; prompts that run /legionctl:dossier pass.
    "gate": true,
    // At session start (new or resumed), bind the session to the last dossier used in the same repository (or
    // folder) when no live session holds it; the agent is told which one.
    "auto_bind": true,
    // Hook events at which the agent (not the user) is told to set up a session that has no dossier: at the start of
    // the session (in its context, before the first prompt) and before it ends a reply.
    "nudge": ["session-start", "stop"],
    // A binding with no activity for this long can be taken over.
    "stale_hours": 12,
    // Artifact classes: <CLASS>/NN-<slug>.md. A layer may add classes; the canonical four stay.
    "classes": {
      "MEMORY": "Working memory: intake, source reads, decision and ambiguity registers, context from chat",
      "DESIGN": "Intended design, separate from plan status and evidence",
      "EVIDENCE": "Proof from real output: validation logs, reports, inventories, comparisons",
      "SPIKE": "Disposable prototypes and reproducible experiments"
    },
    // plan.md: the ledger; `legionctl dossier check` reports a missing section.
    "plan_sections": [
      "Purpose", "Requested Outcome", "Scope Fence", "Governing Principles", "Instruction Inventory",
      "Current Behavior / Findings", "Open Questions / Decision Points", "Complexity / Trade-offs",
      "Options / Recommendation", "User Decisions / Approval", "Design", "Acceptance Criteria",
      "Requirement-to-Change Map", "Done", "ToDo", "Deferred", "Rejected", "Validation / Evidence Status"
    ]
  },

  // Sessions that legionctl starts (`legionctl session start <agent>`, note 14): the agent runs in a sandbox where
  // your home is read-only.
  "session": {
    // Agent name -> command line; {id} is the session id (Claude Code's hooks then find the session's dossier);
    // {settings} is the session's generated Claude Code settings file (the gates as permissions.deny); {mcp} is its
    // MCP config: legionctl's own server and each of mcp.servers through legionctl mcp-proxy, and no other.
    "agents": {
      "claude": ["claude", "--session-id", "{id}", "--settings", "{settings}", "--mcp-config", "{mcp}", "--strict-mcp-config"],
      "codex": ["codex"]
    },
    // Writable besides the workspace, the dossier, the repository's .git and the runtime folder (/tmp is private to
    // the session): the agents' own state.
    "writable": ["~/.claude", "~/.claude.json", "~/.codex", "~/.cache"]
  },

  // MCP servers for session agents: name -> { "command": [...], "allow": [tools] }. The agent reaches each only
  // through legionctl mcp-proxy, which offers the allowed tools and logs every call (legionctl tools calls).
  "mcp": {
    "servers": {}
  },

  // Gates on commands in a session sandbox. /etc/legionctl can lock them.
  "gates": {
    "git": {
      // Refused: a subcommand and the flags that make it unsafe. Merge goes through workspace_merge; pushes and
      // history changes stay with the user.
      "deny": [
        "push", "fetch", "pull", "remote", "reset --hard", "rebase", "clean -f", "branch -D",
        "branch --delete --force", "filter-branch", "gc --prune", "update-ref", "reflog expire"
      ]
    }
  },

  // When the load counts as busy or overloaded (`legionctl load`). Pressure values are PSI avg10 percentages.
  "load": {
    "disk_busy_percent": 10,
    "busy": {
      "cpu_pressure": 20,
      "memory_pressure": 10,
      "io_pressure": 20,
      "memory_available_percent": 15,
      "load_per_cpu": 0.75
    },
    "overloaded": {
      "cpu_pressure": 60,
      "memory_pressure": 10,
      "io_pressure": 30,
      "memory_available_percent": 5,
      "load_per_cpu": 1.5
    }
  }
}
