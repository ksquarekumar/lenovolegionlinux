// legionctl defaults: the lowest config layer, compiled into every legionctl binary.
//
// Layers, lowest first: these defaults, /etc/legionctl/*.jsonc (system), ~/.config/legionctl/*.jsonc (user),
// <repo>/.legionctl/*.jsonc (repository). Files in a layer merge in name order; in the user layer, managed.jsonc
// (written by `legionctl reminders` and `legionctl hooks`) merges last.
//
// Merge: objects merge per key; any other value replaces the lower one; `null` removes the key; "name+": [...]
// appends to the array "name". `legionctl config explain <key>` shows which file set a value.
{
  "config": {
    // Only these defaults and /etc/legionctl may set "config". Lowest first.
    "precedence": ["defaults", "system", "user", "repo"],
    // Keys or prefixes ("hooks.actions") that only the defaults and /etc/legionctl may set.
    "locked": [],
    // Keys or prefixes that a repository's .legionctl file sets only after you allow that file once (trust on first
    // use): legionctl asks with a desktop notification the first time, and again when the file changes. Until you
    // allow it, and after Deny, the file's values of these keys are not used (`legionctl config layers` says so).
    "approve": ["hooks", "session", "gates", "gateway", "mcp", "packages", "plugins", "dossier", "workspace", "runnables"]
  },

  "workspace": {
    // Workspaces (a dossier's operating directory in a repository) live in <root>/<repo>/<dossier>.
    "root": "/data/worktrees",
    // Tell the agent to open one: at session start when the dossier has none in this repository, and before a reply
    // ends when the main checkout has changes (decided 2026-10-13: a nudge, not a write block).
    "nudge": true
  },

  // Reminders that the hooks inject into agent sessions. Turn one on or off with "<id>": {"enabled": ...}.
  "reminders": {
    "ste100": {
      "text": "Write all user-facing text in ASD-STE100 Simplified Technical English (skill legionctl:ste100-style).",
      "event": "prompt",
      "enabled": true
    },
    "glanceable": {
      "text": "Structure user-facing output for a glance: answer first, then layered detail; exact identifiers; no repetition (skill legionctl:glanceable-style).",
      "event": "prompt",
      "enabled": true
    },
    "dossier-practice": {
      "text": "Keep this session's dossier current in the same turn: state in plan.md, detail in MEMORY, DESIGN and EVIDENCE (skill legionctl:dossier-practice).",
      "event": "prompt",
      "enabled": true
    },
    "load-aware": {
      "text": "Check the legionctl load (MCP tool `load`) before builds, test suites or parallel jobs, and scale them down when busy.",
      "event": "session-start",
      "enabled": false
    },
    "workspace": {
      "text": "Change code in the dossier's workspace (MCP tool workspace_open), not in the repository's own checkout.",
      "event": "session-start",
      "enabled": false
    }
  },

  "hooks": {
    // Your own actions: "<id>": {"command": "one-line shell command", "timeout": seconds (1-30)}.
    // Built-in actions: reminders, load, load-if-busy, setup-check.
    "actions": {},
    // What runs, in order, for each hook event.
    "bindings": {
      "session-start": ["reminders", "load", "setup-check"],
      "prompt": ["reminders", "load-if-busy"]
    }
  },

  // Dossiers (note 18): one writable dossier per agent session, in <root>/<dossier>/. Each directory where a
  // dossier is used gets the link agentWorkspaces -> <root> (design 23, E1a).
  "dossier": {
    "root": "~/agentWorkspaces",
    // In a repository where a dossier was used (a linked repository), block each prompt of a session that has no
    // dossier; prompts that run /legionctl:dossier pass. Elsewhere legionctl never blocks, nudges or binds.
    "gate": true,
    // At session start (new or resumed) and at each prompt, bind a session in a linked repository to the last dossier
    // used there when no live session holds it; the agent is told which one.
    "auto_bind": true,
    // Hook events at which the agent (not the user) is told to set up a session that has no dossier: at the start of
    // the session (in its context, before the first prompt) and before it ends a reply.
    "nudge": ["session-start", "stop"],
    // Replies that change the workspace while the session does not write its dossier: at this many the agent is told
    // on the next prompt (info), at twice this the end of its reply is stopped once (warn), at three times each reply
    // is stopped until it writes the dossier (block). A dossier write is the answer and starts the count again. Each
    // level and each answer is an event (`legionctl dossier nudges`). 0 turns this off.
    "nudge_turns": 5,
    // A binding with no activity for this long can be taken over.
    "stale_hours": 12,
    // A message between agents (thread send) longer than this, with no link to a dossier artifact (plan#todo-NN,
    // MEMORY-n, DESIGN-n, EVIDENCE/..., JOURNAL/..., a commit), gets a one-line hint in the answer: put the details in
    // the dossier and link them. The message is sent all the same. 0 turns this off.
    "message_chars": 600,
    // Artifact classes: <CLASS>/NN-<slug>.md. A layer may add classes; the canonical four stay.
    "classes": {
      "MEMORY": "Working memory: intake, source reads, decision and ambiguity registers, context from chat",
      "DESIGN": "Intended design, separate from plan status and evidence",
      "EVIDENCE": "Proof from real output: validation logs, reports, inventories, comparisons",
      "SPIKE": "Disposable prototypes and reproducible experiments",
      "JOURNAL": "Serial entries, one per compaction or hand-off: state, decisions and open work as links, not copies",
      "HEALTH": "Dossier and planning health notes (dossier health), one before each compaction"
    },
    // Artifacts of these classes cannot change once written (as front matter immutable: true): a correction is a new
    // entry whose front matter supersedes the old one.
    "immutable_classes": ["JOURNAL", "HEALTH", "feedbacks"],
    // plan.md: the ledger; `legionctl dossier check` reports a missing section.
    "plan_sections": [
      "Purpose", "Requested Outcome", "Scope Fence", "Governing Principles", "Instruction Inventory",
      "Current Behavior / Findings", "Open Questions / Decision Points", "Complexity / Trade-offs",
      "Options / Recommendation", "User Decisions / Approval", "Design", "Acceptance Criteria",
      "Requirement-to-Change Map", "Done", "ToDo", "Deferred", "Rejected", "Validation / Evidence Status"
    ]
  },

  // Sessions that legionctl starts (`legionctl session start <agent>`, note 14): the agent runs in a sandbox where
  // your home is read-only.
  "session": {
    // Agent name -> command line; {id} is the session id (Claude Code's hooks then find the session's dossier);
    // {settings} is the session's generated Claude Code settings file (the gates as permissions.deny); {mcp} is its
    // MCP config: legionctl's own server and each of mcp.servers through legionctl mcp-proxy, and no other.
    "agents": {
      "claude": ["claude", "--session-id", "{id}", "--settings", "{settings}", "--mcp-config", "{mcp}", "--strict-mcp-config"],
      "codex": ["codex"]
    },
    // Agent name -> the command that continues an ended session (legionctl session resume <id>).
    "resume": {
      "claude": ["claude", "--resume", "{id}", "--settings", "{settings}", "--mcp-config", "{mcp}", "--strict-mcp-config"]
    },
    // Agent name -> its ACP adapter, for headless runs (legionctl session run): Zed's adapters for Claude Code and
    // Codex. The adapter gets the session's MCP servers (legionctl's own and the proxied ones) at session/new.
    "acp": {
      "claude": ["claude-code-acp"],
      "codex": ["codex-acp"]
    },
    // The agents of "acp" whose adapter can be bound to given tools (a bound run, such as the ui-composer's, gets
    // only legionctl's MCP server with those tools: no file, shell or web tools, no settings, plugins or other MCP
    // servers). claude-code-acp takes the binding in session/new (_meta disableBuiltInTools, settingSources []);
    // codex-acp 0.16 has no way to turn off its shell, so a bound run on codex fails.
    "acp_bind": ["claude"],
    // ACP adapter command -> its npm package. `legionctl setup check` reports an adapter command of "acp" that is not
    // on the PATH of the systemd user manager (with bun's global folder, `bun pm -g bin`); `setup apply` installs it
    // with `bun add -g <package>`.
    "acp_packages": {
      "claude-code-acp": "@zed-industries/claude-code-acp",
      "codex-acp": "@zed-industries/codex-acp"
    },
    // Each session in its own systemd user scope (legionctl-session-<id>), for limits, pause and stop.
    "scope": true,
    // What legionctl does by itself with sessions; off by default (0). idle_freeze_minutes: freeze an interactive
    // session that many minutes after its agent ended a reply and no prompt came (5 when you want it); it shows as
    // frozen in `legionctl session list` and a desktop notification, and `legionctl session unpause <id>` thaws it.
    // offload_headless: stop headless runs while memory is under pressure (the load.busy limits) and go on with
    // them in their sessions when it eases (`legionctl jobs list` shows them offloaded).
    "policy": { "idle_freeze_minutes": 0, "offload_headless": false },
    // Sessions in a container (`--in container`) run the repository's agent image, made by `legionctl workspace
    // pack`: the repository's own image (else `base`) plus git, Node.js, these npm packages (the agents and their ACP
    // adapters) and `client`, a static legionctl (the package installs it) as MCP server, hook client and git gate.
    "container": {
      "base": "public.ecr.aws/docker/library/debian:trixie-slim",
      "npm": ["@anthropic-ai/claude-code", "@zed-industries/claude-code-acp", "@openai/codex", "@zed-industries/codex-acp"],
      "client": "/usr/lib/legionctl/legionctl-static"
    },
    // Sessions in a VM (`--in vm`) run on the repository's disk, made by `legionctl workspace pack --as vm`: a layer
    // over this cloud image with git, Node.js, the npm packages above and the static client. Each session gets a
    // throwaway layer over the disk; its folders are shared with virtiofs.
    "vm": {
      "base": "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2",
      "disk_gib": 20,
      "memory_mib": 4096,
      "cpus": 4,
      "virtiofsd": "/usr/lib/virtiofsd"
    },
    // The agents' own state, which they write (/tmp is private to the session). Never the real files: on the host each
    // folder is an overlay whose writes stay in the session (~/.local/state/legionctl/session-home/<id>), in a
    // container or VM the session's own copy; each file is the session's own copy. A resume keeps them.
    "writable": ["~/.claude", "~/.claude.json", "~/.codex"],
    // Caches of the agent's tools: on the host an overlay whose writes stay in the session; a container or VM has
    // its own.
    "caches": ["~/.cache"],
    // Skills from the package store: "<package>" or "<package>/<folder in it>", each a folder with SKILL.md. When
    // set, Claude Code and Codex see exactly these (read-only, hash-checked at session start); null keeps the user's.
    "skills": null,
    // Hidden in the sandbox (`~/` is the home): a container or VM manager or the system bus would let the agent act on
    // the host, keys and tokens would let it act as you. The runtime folder (session bus, systemd, GnuPG, ssh and
    // keyring agents) is hidden always, but legionctl's part; so is each .env file at the top of the repository and
    // the workspace. Agents that push use the git gate, not your credentials.
    "hidden": [
      "/run/docker.sock", "/var/run/docker.sock", "/run/containerd", "/run/podman", "/run/libvirt", "/var/run/libvirt",
      "/run/dbus/system_bus_socket",
      "~/.ssh", "~/.gnupg", "~/.git-credentials", "~/.netrc", "~/.config/gh", "~/.docker", "~/.npmrc", "~/.pypirc",
      "~/.cargo/credentials.toml", "~/.cargo/credentials", "~/.aws", "~/.kube", "~/.local/share/keyrings",
      "~/.password-store", "~/.mozilla", "~/.config/google-chrome", "~/.config/chromium",
      "~/.local/state/legionctl", "~/.local/share/legionctl/accounts"
    ]
  },

  // MCP servers for session agents: name -> { "command": [...] or "package": name, "allow": [tools] }. The agent reaches each only
  // through legionctl mcp-proxy, which offers the allowed tools and logs every call (legionctl tools calls).
  "mcp": {
    "servers": {}
  },

  // The model gateway in the operator: Anthropic and OpenAI APIs on 127.0.0.1:<port>, off until a port is set (for
  // example 4711; then ANTHROPIC_BASE_URL or OPENAI_BASE_URL=http://127.0.0.1:4711, which also works in sessions in a
  // container or VM). Accounts: name -> { "provider": anthropic|openai, "base_url",
  // "keyring": true to use the key stored with `secret-tool store --label=... legionctl-account <name>` }; without
  // keyring the caller's own credentials go through. Pool: model (or "*") -> accounts in order. Prices: model -> { "input", "output",
  // optional "cache_read", "cache_write" (prompt-cache tokens; else they cost "input") } in USD per million tokens
  // (none built in: prices change). Budgets: "account/model" -> { "day_usd", "month_usd" }
  // (rolling 24 hours and 30 days); a budget needs a price for its model.
  "gateway": {
    "port": 0,
    "accounts": {
      "anthropic": { "provider": "anthropic", "base_url": "https://api.anthropic.com" },
      "openai": { "provider": "openai", "base_url": "https://api.openai.com" }
    },
    "pool": { "*": ["anthropic", "openai"] },
    "cache_ttl_s": 86400,
    "budgets": {},
    "prices": {},
    // The semantic cache (x-legionctl-cache: semantic): { "account": an openai account (a local model works), "model":
    // its embedding model, "threshold": cosine similarity 0-1 at which a kept answer replays }; null is off.
    "semantic": null
  },

  // Agent plugins legionctl may install (legionctl agents plugins install <plugin>@<marketplace>): marketplace name
  // (its own, from its marketplace.json) -> { "source": owner/repo, a git or https URL, or a path; "allow": plugin
  // names, or "*" }. legionctl agents plugins list marks what is installed outside this list.
  "plugins": { "marketplaces": {} },

  // The operator's event log and gateway usage (DESIGN/03): days to keep; older rows go when the operator starts. The
  // gateway's money budgets look back 30 days, so keep at least that. 0 keeps everything.
  "events": { "keep_days": 90 },

  // The disposable cache (~/.cache/legionctl/cache.db; delete it any time): namespace -> bytes it may hold. tools: the
  // MCP proxy's tool results; gateway: the model gateway's kept answers; accounts: the accounts' usage answers. The
  // least recently used go first.
  "cache": {
    "tools": { "max_bytes": 268435456 },
    "gateway": { "max_bytes": 1073741824 },
    "accounts": { "max_bytes": 1048576 }
  },

  // The package store: name -> { "kind": npm|pypi|cargo|git|path, "source", "version" (the pin), "run" (the MCP
  // server's command, {dir} = the package folder), "network" (default false) }. legionctl packages fetch installs one.
  "packages": {},

  // Gates on commands in a session sandbox. /etc/legionctl can lock them.
  // The installed Windows in a VM (note 05; `legionctl windows vm start`): its own NVMe disk through VFIO, the GPU when
  // you give it (`legionctl gpu give windows`), a SPICE display, these CPUs and this memory (VFIO locks all of it).
  "windows": {
    "vm": {
      "host_cpus": "0-7,16-19",
      "vcpus": 12,
      "memory_mib": 24576,
      "reserve_mib": 2048,
      "usb": ["046d:c548"],
      "shares": [],
      "looking_glass_mib": 128,
      "ovmf_code": "/usr/share/edk2/x64/OVMF_CODE.4m.fd",
      "ovmf_vars": "/usr/share/edk2/x64/OVMF_VARS.4m.fd"
    }
  },

  // Agent configs (design 23, B+2): name -> { "archetype": main-agent|thread-observer|ui-composer, and the fields it
  // changes: "harness" (claude|codex; none: both), "account", "model", "effort", "tools": {allow, deny}, "skills",
  // "mcp" (legionctl or names in mcp.servers), "commands": {allow, deny, ask}, "instructions" (files), "pace",
  // "budget": {tokens_per_day, wake_tokens, wake_seconds}, "sandbox" and "approval" (Codex sessions), "capabilities"
  // (capability sets, DESIGN-13) }. The archetype file (integrations/agent-plugin/agents/<archetype>.md) is the layer
  // below; the repository layer and a team may only narrow tools, commands, budgets and capabilities. `legionctl
  // runnables check [--team <t>] [--harness claude|codex]` resolves them and refuses each field that a run path cannot
  // apply; `legionctl setup apply` writes them as Codex agents. A session (the main agent) requests the capabilities
  // of main-agent; a member those of its config. Bound agents (observers, the composer) get no web-read.
  "agents": {
    "configs": {
      "main-agent": { "archetype": "main-agent", "capabilities": ["web-read", "github-read", "dossier-write", "machine-read"] },
      "thread-observer": { "archetype": "thread-observer", "pace": "on-trigger", "budget": { "tokens_per_day": 2000000 } },
      "ui-composer": { "archetype": "ui-composer", "pace": "on-trigger", "budget": { "tokens_per_day": 500000 } }
    },
    // Account usage and the switch at the limit (todo-136). `legionctl agents accounts usage` reads each profile's
    // 5 h and 7 d use from the provider with the profile's own access token (never refreshed: the agents rotate
    // their refresh tokens) and keeps each answer, or its error, for "usage_ttl_s" seconds. "fallback": agent
    // (claude, codex) -> account profiles in order; none: no switch. With a list, an operator member whose account
    // has a window at "switch_at" percent or more continues on the first account of the list that is under it
    // (session resume --account), with a thread note; when no account is under it, or its use cannot be read, the
    // wake fails with the reason. Only the defaults, /etc/legionctl and the user layer apply: a repository cannot
    // send a token elsewhere or pick an account.
    "accounts": {
      "usage_ttl_s": 300,
      "switch_at": 90,
      "fallback": {},
      "endpoints": {
        "claude": "https://api.anthropic.com/api/oauth/usage",
        "codex": "https://chatgpt.com/backend-api/wham/usage"
      }
    }
  },

  // rlcd (todo-138): System One decision models (typed questions: choice, yes-no, score; calibrated answers, no
  // text). "backend": the backend that a member's rlcd and `legionctl rlcd ask` use when they name none. "backends":
  // name -> { "shape": system-one (OpenRouter /api/alpha/decisions) | openai (/v1/decisions), "url", "model",
  // "keyring": the entry of its API key (`secret-tool store --label=... legionctl-rlcd <keyring>`), "timeout_ms": a
  // slower call fails }. Only the defaults, /etc/legionctl and the user layer may set a backend's url or keyring (a
  // repository could send the key elsewhere); a repository may select a backend. A failed call fails its step: no
  // other backend runs in its place. openrouter-free is for development (a repository layer selects it).
  "rlcd": {
    "backend": "openrouter",
    "backends": {
      "openrouter": { "shape": "system-one", "url": "https://openrouter.ai/api/alpha/decisions", "model": "typesafe/jev-1.14", "keyring": "openrouter", "timeout_ms": 10000 },
      "openrouter-free": { "shape": "system-one", "url": "https://openrouter.ai/api/alpha/decisions", "model": "inception/mercury-decide:free", "keyring": "openrouter", "timeout_ms": 10000 },
      "openai": { "shape": "openai", "url": "https://api.openai.com/v1/decisions", "model": "gpt-6-luna", "keyring": "openai", "timeout_ms": 10000 }
    }
  },

  // Project checks (design 23, E2): each repository declares its checks in <repo>/.legionctl/checks.jsonc as
  // "checks": { "<name>": { "kind": format|lint|static|types|build|test|deploy|install, "run": "<command>",
  // "fix": "<command>", "gate": checkpoint|merge, "profiles": [files the run writes], "runner": {"format": "libtest"} } }.
  // `workspace checkpoint` runs the gate: checkpoint checks and `workspace merge` the gate: merge checks when no
  // passing run exists at the tree; `legionctl code checks detect` proposes a file from the language files.
  "checks": {
    // The kinds each repository must have: a missing kind is a finding in doctor and dossier check.
    "required": ["format", "lint", "build", "test"],
    // At session start, tell the agent which required kinds the repository lacks.
    "nudge": true,
    // Run folders (<dossier>/.state/runs/<run>/) kept per check; a run that an EVIDENCE front matter names
    // (runs: [<run>]) stays.
    "keep_runs": 20,
    // A run that takes longer is killed with its process group and fails.
    "timeout_minutes": 60
  },

  "gates": {
    "git": {
      // Refused: a subcommand and the flags that make it unsafe. Merge goes through workspace_merge; pushes and
      // history changes stay with the user.
      "deny": [
        "push", "fetch", "pull", "remote", "reset --hard", "rebase", "clean -f", "branch -D",
        "branch --delete --force", "filter-branch", "gc --prune", "update-ref", "reflog expire"
      ]
    }
  },

  // When the load counts as busy or overloaded (`legionctl load`). Pressure values are PSI avg10 percentages.
  "load": {
    "disk_busy_percent": 10,
    "busy": {
      "cpu_pressure": 20,
      "memory_pressure": 10,
      "io_pressure": 20,
      "memory_available_percent": 15,
      "load_per_cpu": 0.75
    },
    "overloaded": {
      "cpu_pressure": 60,
      "memory_pressure": 10,
      "io_pressure": 30,
      "memory_available_percent": 5,
      "load_per_cpu": 1.5
    }
  },

  // Capability sets (DESIGN-13): named, versioned parts of a runnable's manifest in config/capabilities (shipped), and
  // in the folder capabilities/ of /etc/legionctl, ~/.config/legionctl and a repository's .legionctl. A session gets
  // the set of its harness and of its repository's languages by itself, and the sets that it names (its config, a
  // team member's config, `session start --capability <set>`). The grant is the subset that its environment, its
  // parent and this layer allow; anything else refuses the start with the reason. "allow": the shipped, system and
  // user sets that a grant may hold; a repository's own set needs no entry, but its powerful parts (host, storage,
  // toolverse, connections, harness) need your first-use answer. `legionctl runnables show <session>` gives a grant.
  "runnables": {
    "allow": ["claude-code", "codex", "rust-dev", "node-dev", "python-dev", "web-read", "github-read", "dossier-write", "machine-read"]
  },

  // The desktop app (legionctl-app).
  "app": {
    // The chat bar's agent, a name of session.acp, in a thread where nobody picked one with `/agent <name>` (the
    // pick is a row of the thread's log); null: no agent until a pick.
    "agent": "claude"
  },

  // Views (DESIGN-09 G5). An intent typed in a tab's chat bar (or `legionctl ask "<intent>"`) opens the stored view
  // whose intent it is word for word; else, with "rlcd" true, the stored view that rlcd picks with at least
  // "rlcd_min"; else the ui-composer (the chat bar's agent over ACP) makes a view, or a new version of the tab's view.
  // "composer_models": the composer's model per agent of session.acp (ACP session/set_model): Haiku on Claude Code;
  // an agent with no entry uses its account's default model (Codex: user 2026-10-16, a ChatGPT account has no
  // gpt-6-luna and codex-acp 0.16 has no session/set_model).
  "views": {
    "composer_models": { "claude": "haiku" },
    "rlcd": false,
    "rlcd_min": 0.7
  }
}
