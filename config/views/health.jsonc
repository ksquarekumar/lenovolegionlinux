// Seed (DESIGN-09): doctor's findings by severity, each group with its count: what failed first, then what to check,
// then the agent setup items. A finding that legionctl can fix has its button; the others are states.
{
  "$schema": "../../docs/api/view.schema.json",
  "name": "health",
  "title": "Health",
  "intent": "what is wrong with the machine",
  "space": "machine",
  "widget": "list",
  "source": { "op": "doctor", "path": "$.findings" },
  "columns": ["text"],
  "group": {
    "field": "text",
    "rules": [
      { "group": "Agent setup", "prefix": "setup: " },
      {
        "group": "Failures",
        "any": ["failed", "error", "cannot", "does not answer", "does not run", "not loaded", "no platform", "mixed", "safe mode"]
      }
    ],
    "rest": "To check",
    "order": ["Failures", "To check", "Agent setup"]
  },
  "row_actions": [{ "label": "{item.name}", "op": "{item.op}", "input": "{item.input}", "each": "actions" }],
  "refresh": { "every": 60 }
}
