// Seed (todo-136, todo-188): the accounts from clauth, the account engine. One plain sentence per login and agent:
// its use (clauth's daemon reads it), clauth's state of it (its login, its place in the fallback chain, a live clauth
// session) and when it was read; a profile that holds the same login as another says so. A use that is not read has
// the button that gets it read: Install clauth, Start clauth (lead walk r361: the action is the message). Then the
// newest Claude Code sessions as clauth lists them, in local time (clauth names no account for a session that it did
// not start, so no account column). Log in, Switch account and Save the current login go through clauth.
{
  "$schema": "../../docs/api/view.schema.json",
  "name": "accounts",
  "title": "Accounts",
  "intent": "how much of each account's limits is used",
  "space": "agents",
  "widget": "stack",
  "views": [
    {
      "name": "account-use",
      "title": "Use of each account",
      "widget": "list",
      "source": { "op": "agents.accounts.usage" },
      "columns": ["text"],
      "group": { "field": "account" },
      "row_actions": [{ "label": "{item.name}", "op": "{item.op}", "input": "{item.input}", "each": "actions" }]
    },
    {
      "name": "clauth-sessions",
      "title": "Claude Code sessions (clauth)",
      "widget": "table",
      "source": { "op": "agents.accounts.sessions" },
      "columns": ["updated_at", "workspace"],
      "labels": { "updated_at": "Last written", "workspace": "Folder" },
      "formats": { "updated_at": "time" }
    }
  ],
  "actions": [
    { "label": "Log in to an account", "op": "agents.accounts.login", "input": {} },
    { "label": "Switch account", "op": "agents.accounts.switch", "input": {} },
    { "label": "Save the current login", "op": "agents.accounts.capture", "input": {} },
    { "label": "Set up clauth", "op": "setup.apply", "input": { "install_ctx": false } }
  ],
  "refresh": { "events": ["agents.accounts.*", "setup.*"], "every": 60 }
}
