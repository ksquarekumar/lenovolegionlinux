// Seed (todo-136): the rate-limit windows of each login per agent, from the provider (Claude: 5h then 7d; Codex: its
// windows by length), one plain sentence per agent with when it was read; a read that failed says why. The logins are
// clauth's: the current one (named by the clauth profile that holds it) and clauth's other profiles; a profile that
// holds the same login as another says so. Read again asks the providers now; Log in and Make an account current go
// through clauth; Keep the current login keeps it as an account, never as a copy.
{
  "$schema": "../../docs/api/view.schema.json",
  "name": "accounts",
  "title": "Accounts",
  "intent": "how much of each account's limits is used",
  "space": "agents",
  "widget": "list",
  "source": { "op": "agents.accounts.usage" },
  "columns": ["text"],
  "group": { "field": "account" },
  "actions": [
    { "label": "Read again", "op": "agents.accounts.usage", "input": { "fresh": true } },
    { "label": "Log in to an account", "op": "agents.accounts.login", "input": {} },
    { "label": "Make an account current", "op": "agents.accounts.switch", "input": {} },
    { "label": "Keep the current login", "op": "agents.accounts.capture", "input": {} }
  ],
  "refresh": { "events": ["agents.accounts.*"], "every": 300 }
}
