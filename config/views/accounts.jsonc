// Seed (todo-136): the rate-limit windows of each login per agent, from the provider (Claude: 5h then 7d; Codex: its
// windows by length), with when they were read; a read that failed shows its cause. The logins: the current one
// (named by the clauth profile that holds it), clauth's other profiles, and legionctl's account profiles. Read again
// asks the providers now; Keep the current login keeps it as an account, never as a copy.
{
  "$schema": "../../docs/api/view.schema.json",
  "name": "accounts",
  "title": "Accounts",
  "intent": "how much of each account's limits is used",
  "space": "agents",
  "widget": "table",
  "source": { "op": "agents.accounts.usage" },
  "columns": ["agent", "source", "windows.0.name", "windows.0.used_percent", "windows.1.name", "windows.1.used_percent", "error", "fetched_at"],
  "labels": {
    "agent": "Agent",
    "source": "Login",
    "windows.0.name": "Window",
    "windows.0.used_percent": "Used %",
    "windows.1.name": "Window",
    "windows.1.used_percent": "Used %",
    "error": "Read failed",
    "fetched_at": "Read"
  },
  "formats": { "windows.0.used_percent": "int", "windows.1.used_percent": "int", "fetched_at": "ago" },
  "group": { "field": "account" },
  "actions": [
    { "label": "Read again", "op": "agents.accounts.usage", "input": { "fresh": true } },
    { "label": "Keep the current login", "op": "agents.accounts.capture", "input": {} }
  ],
  "refresh": { "events": ["agents.accounts.*"], "every": 300 }
}
