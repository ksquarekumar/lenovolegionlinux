# Only ADP0 represents the real AC adapter on this machine. Other power_supply
# objects can report online=0 while the laptop is still connected to AC.
SUBSYSTEM=="power_supply", KERNEL=="ADP0", ATTR{type}=="Mains", ATTR{online}=="0", RUN+="/usr/bin/systemctl --no-block start legion-battery.target"
SUBSYSTEM=="power_supply", KERNEL=="ADP0", ATTR{type}=="Mains", ATTR{online}=="1", RUN+="/usr/bin/systemctl --no-block start legion-ac.target"

# Fn+Q and our own writes both change platform_profile; `legionctl follow` tells them apart.
# restart (not start) so the last of several quick presses is always followed.
SUBSYSTEM=="platform-profile", ACTION=="change", RUN+="/usr/bin/systemctl --no-block restart legion-follow.service"
